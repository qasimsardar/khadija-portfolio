---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Img from '../components/Img.astro';
import Button from '../components/Button.astro';
import Marquee from '../components/Marquee.astro';
import TeaserCard from '../components/TeaserCard.astro';
import { projects } from '../data/projects';
import { site } from '../data/site';

const { about } = site;
const disciplines = ['Industrial Design', 'UI/UX', 'Research', 'Prototyping', 'CAD', 'Packaging', 'Branding'];
---

<Base page="home">
  <div class="backdrop" data-backdrop aria-hidden="true"></div>
  <Hero workHref="#work" />

  <section id="work" class="work" aria-labelledby="work-title" data-work>
    <div class="container-wide work-head">
      <h2 id="work-title" class="label">Selected work</h2>
      <p class="label count">({String(projects.length).padStart(2, '0')})</p>
    </div>
    {
      projects.map((p, i) =>
        p.href ? (
          <article
            class="card"
            data-card
            data-accent={p.accent}
            data-tone={p.tone.bg}
            data-ink={p.tone.ink}
            data-muted={p.tone.muted}
            style={`--tone: ${p.tone.bg}; --tone-ink: ${p.tone.ink}; --tone-muted: ${p.tone.muted}; --card-accent: ${p.accent}`}
            aria-labelledby={`card-${p.slug}`}
          >
            <div class="container-wide card-inner">
              <header class="card-head">
                <span class="num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3 id={`card-${p.slug}`} class="title">
                  <a href={p.href} data-morph data-cursor="View" data-chars>
                    {p.name}
                  </a>
                </h3>
                <span class="pill">{p.category}</span>
              </header>
              <div class="frame-wrap">
                {p.slug === 'prisma' && <span class="glow" aria-hidden="true" />}
                <a class="frame" href={p.href} data-morph data-cursor="View" tabindex="-1" aria-hidden="true" data-reveal="clip">
                  <div class="frame-media" transition:name={`hero-${p.slug}`}>
                    <Img src={p.cover.src} alt={p.cover.alt} sizes="(min-width: 1440px) 1340px, 92vw" data-parallax-img="" />
                  </div>
                </a>
              </div>
              <div class="card-foot">
                <p class="desc">
                  <strong class:list={['mark', `mark-${p.slug}`]}>{p.mark}</strong> {p.description}
                </p>
                <Button href={p.href} variant="secondary" cursor="Open" accent={p.accent}>
                  View case study
                </Button>
              </div>
            </div>
          </article>
        ) : (
          <TeaserCard project={p} index={i} />
        ),
      )
    }
  </section>

  <Marquee items={disciplines} />

  <section id="about" class="about container-wide" aria-labelledby="about-title">
    <p class="label kicker">About</p>
    <div class="about-grid">
      <figure class="portrait" data-reveal="clip">
        <Img src="about/headshot.jpg" alt="Portrait of Khadija Sardar" sizes="(min-width: 900px) 40vw, 92vw" />
      </figure>
      <div class="about-body">
        <h2 id="about-title" class="statement" data-words>{about.statement}</h2>
        {about.bio && <p class="copy bio">{about.bio}</p>}
        <div class="facts">
          <div>
            <h3 class="label fact-title">Skills</h3>
            <ul class="skills" data-stagger="0.05">
              {about.skills.map((s) => <li class="pill">{s}</li>)}
            </ul>
          </div>
          {
            about.tools.length > 0 && (
              <div>
                <h3 class="label fact-title">Tools</h3>
                <ul class="skills">
                  {about.tools.map((s) => (
                    <li class="pill">{s}</li>
                  ))}
                </ul>
              </div>
            )
          }
          {
            about.education.length > 0 && (
              <div>
                <h3 class="label fact-title">Education</h3>
                <ul class="edu">
                  {about.education.map((e) => (
                    <li>
                      <strong>{e.school}</strong> {e.detail}
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>
        <div class="about-actions">
          <Button href="#contact">Let’s work together</Button>
          <Button href="/work" variant="link" magnetic={false}>See every project</Button>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Fixed colour layer the work section tweens through (keeps repaints off the content). */
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: var(--paper);
  }

  .work {
    --work-ink: var(--ink);
    --work-muted: var(--ink-2);
    position: relative;
    padding-top: clamp(40px, 6vw, 96px);
  }

  :global(.js:not(.reduced-motion)) .work {
    color: var(--work-ink);
  }

  .work-head {
    display: flex;
    justify-content: space-between;
    padding-bottom: clamp(20px, 3vw, 40px);
    color: inherit;
  }

  .count {
    opacity: 0.6;
  }

  /* Without JS (or with reduced motion) each card carries its own tone. */
  .card {
    padding-block: clamp(56px, 7vw, 120px);
    background: var(--tone);
    color: var(--tone-ink);
  }

  :global(.js:not(.reduced-motion)) .card {
    background: transparent;
    color: inherit;
  }

  .card-inner {
    display: grid;
    gap: clamp(22px, 2.6vw, 36px);
  }

  .card-head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 16px clamp(16px, 3vw, 40px);
  }

  .num {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    letter-spacing: 0.08em;
    opacity: 0.7;
  }

  .title {
    font-weight: 300;
    font-size: var(--fs-mega);
    line-height: 0.92;
    letter-spacing: -0.055em;
  }

  .title a {
    display: inline-block;
  }

  .frame {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    isolation: isolate;
  }

  .frame-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
  }

  .frame-media :global(img) {
    width: 100%;
    height: 118%;
    margin-top: -9%;
    object-fit: cover;
    transition: transform var(--dur-3) var(--ease-out);
  }

  .frame:hover .frame-media :global(img) {
    transform: scale(1.04);
  }

  .frame-wrap {
    position: relative;
    isolation: isolate;
  }

  /* Prisma: slow RGB glow bleeding out from behind the black product frame. */
  .glow {
    position: absolute;
    inset: 8% 14%;
    z-index: -1;
    border-radius: 50%;
    background: conic-gradient(from 0deg, #dd1886, #7d4c9e, #3e82c4, #2ee6c9, #d5ee74, #dd1886);
    filter: blur(70px);
    opacity: 0.5;
    animation: spin 14s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(1turn);
    }
  }

  .card-foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 24px clamp(32px, 6vw, 120px);
  }

  .desc {
    max-width: 52ch;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--tone-muted);
  }

  :global(.js:not(.reduced-motion)) .desc {
    color: var(--work-muted);
  }

  /* The name keeps the readable ink of whatever tone is behind it; the project accent rides along as an underline. */
  .mark {
    font-weight: 600;
    color: var(--work-ink, inherit);
    text-decoration: underline;
    text-decoration-color: var(--card-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.22em;
  }

  /* About */
  .about {
    padding-block: var(--section-gap);
  }

  .kicker {
    margin-bottom: clamp(28px, 4vw, 56px);
    color: var(--ink-3);
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 6vw, 112px);
    align-items: start;
  }

  .portrait {
    position: sticky;
    top: 110px;
    overflow: hidden;
    border-radius: var(--radius);
    aspect-ratio: 3 / 4;
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .statement {
    font-weight: 300;
    font-size: var(--fs-h2);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .bio {
    margin-top: clamp(24px, 3vw, 40px);
    max-width: 58ch;
  }

  .facts {
    display: grid;
    gap: clamp(24px, 3vw, 36px);
    margin-top: clamp(40px, 5vw, 72px);
  }

  .fact-title {
    margin-bottom: 14px;
    color: var(--ink-3);
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
  }

  .skills .pill {
    padding: 10px 16px;
    border-color: var(--line);
    color: var(--ink);
  }

  .edu {
    display: grid;
    gap: 8px;
    list-style: none;
    color: var(--ink-2);
  }

  .about-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: clamp(40px, 5vw, 64px);
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .portrait {
      position: relative;
      top: 0;
      max-width: 420px;
    }
  }

  @media (max-width: 720px) {
    .card-head {
      grid-template-columns: auto 1fr;
    }

    .card-head .pill {
      grid-column: 1 / -1;
    }

    .frame {
      aspect-ratio: 4 / 3;
    }

    .card-foot {
      grid-template-columns: 1fr;
    }
  }
</style>
