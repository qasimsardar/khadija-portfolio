---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---

<Base page="404" title="Page not found" description="This page doesn’t exist." noindex>
  <section class="missing container-wide" aria-labelledby="missing-title">
    <p class="label kicker">Error 404</p>
    <h1 id="missing-title" class="display title" data-split="intro">
      This page <span class="accent">wandered off</span>.
    </h1>
    <p class="lead copy" data-reveal>The link may be old or mistyped. Her work is one click away.</p>
    <div class="actions" data-reveal>
      <Button href="/">Back to home</Button>
      <Button href="/work" variant="link" magnetic={false}>See every project</Button>
    </div>
  </section>
</Base>

<style>
  .missing {
    display: grid;
    align-content: end;
    gap: clamp(24px, 3vw, 40px);
    min-height: 88svh;
    padding-block: clamp(140px, 20vh, 220px) clamp(48px, 8vh, 96px);
  }

  .kicker {
    color: var(--ink-3);
  }

  .title {
    max-width: 14ch;
  }

  .copy {
    max-width: 40ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }
</style>
