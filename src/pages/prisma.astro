---
import '@fontsource/source-sans-3/400.css';
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import SectionTitle from '../components/SectionTitle.astro';
import LazyVideo from '../components/LazyVideo.astro';
import CaseHero from '../components/case/CaseHero.astro';
import MetaStrip from '../components/case/MetaStrip.astro';
import NextProject from '../components/case/NextProject.astro';
import { projects } from '../data/projects';

const project = projects.find((p) => p.slug === 'prisma')!;
const marker = '#fce5d6';
const pains = [
  // The first description is set at 16px in the Figma file; the other two are 20px.
  { title: 'Loud Music', text: 'Energetic music creates a loud environment', small: true },
  { title: 'Increased Vocal Effort', text: 'Repeated shouting can lead to vocal fatigue and discomfort' },
  { title: 'Voice Strain', text: 'Instructors have to speak louder to be heard over the music' },
];
const sources = [
  { title: 'Surveys', text: 'User preferences and behaviors', tone: 'lilac' },
  { title: 'Reddit', text: 'Real-world experiences', tone: 'peach' },
  { title: 'Instructor Insights', text: 'First-hand observations', tone: 'lilac' },
];
const needs = [
  { icon: 'prisma/icon-sound.png', label: 'Clear, Powerful Sound' },
  { icon: 'prisma/icon-mic.png', label: 'Audible Instructions' },
  { icon: 'prisma/icon-portable.png', label: 'Portability' },
  { icon: 'prisma/icon-controls.png', label: 'Less Manual Adjustment' },
  { icon: 'prisma/icon-battery.png', label: 'Long Battery Life' },
];
const swatches = ['#434B9F', '#DD1886', '#AC4396', '#7D4C9E', '#3E82C4'];
const protoAlts = [
  'Printed speaker housing panels and handle laid out on a workbench',
  'Handle frame and perforated speaker shell before assembly',
  'Speaker end cap next to a can of Krylon Fusion satin black spray paint',
  'Sewing the speaker mesh cover on a sewing machine',
  'Fitting the circuit board and speaker drivers into the housing',
  'Battery pack and two speaker drivers mounted in their enclosures',
  'Testing the LED strip inside the translucent handle frame',
  'Spray-painting the mesh cover',
  'Mesh cover wrapped over the triangular speaker body',
  'Speaker body fully covered in black mesh',
  'Wiring the electronics into the speaker shell',
  'Electronics, battery and drivers assembled inside the housing',
];
const gallerySmall = {
  left: [
    { src: 'prisma/final-l1.jpg', alt: 'Final Prisma prototype in black with a white frame, front three-quarter view' },
    { src: 'prisma/final-l2.jpg', alt: 'Final Prisma prototype seen from the end cap with its handle' },
    { src: 'prisma/final-l3.jpg', alt: 'Final Prisma prototype standing upright on its triangular end' },
  ],
  right: [
    { src: 'prisma/final-r1.jpg', alt: 'Prisma prototype lit with RGB LEDs on a blue backdrop' },
    { src: 'prisma/final-r2.jpg', alt: 'Underside of the Prisma prototype glowing with RGB light' },
    { src: 'prisma/final-r3.jpg', alt: 'Prisma prototype end view with LEDs glowing' },
  ],
};
---

<Base
  page="prisma"
  title="Prisma"
  accent={project.accent}
  progress
  navOnDark
  ogImage="prisma/hero.jpg"
  description="PRISMA is a portable, multifunctional speaker for fitness and dance instructors, combining powerful sound, customizable RGB lighting and hands-free voice amplification."
>
  <CaseHero project={project} dark>
    <div slot="overlay" class="sweep" aria-hidden="true"><span></span></div>
  </CaseHero>
  <MetaStrip project={project} />

  <div class="case">
    <section class="container" aria-labelledby="research">
      <div class="research">
        <div class="research-text">
          <SectionTitle marker={marker} led id="research">User Research</SectionTitle>
          <p class="copy" data-reveal>
            <strong>Zumba instructors</strong> lead energetic group classes, using <strong>music</strong> to <strong>motivate</strong>
            participants while giving <strong>verbal instructions</strong>. They <strong>constantly move</strong> and demonstrate
            exercises, often needing <strong>portable audio equipment</strong> and <strong>clear voice projection.</strong>
          </p>
        </div>
        <div data-reveal>
          <Img
            src="prisma/research-instructor.jpg"
            alt="Sketch of a dance instructor wearing a headset microphone, leading a class"
            sizes="(min-width: 1280px) 852px, (min-width: 800px) 67vw, 100vw"
          />
        </div>
      </div>
      <div class="flow" data-reveal>
        <Img src="prisma/research-flow.jpg" alt="Sketches showing a loud speaker, an instructor shouting over it, and resulting voice strain" />
      </div>
      <ol class="pains" data-chain>
        {
          pains.map((p, i) => (
            <li data-chain-step>
              <span class="num" aria-hidden="true">
                {i + 1}
              </span>
              <p>
                <strong>{p.title}</strong>
                <br />
                <span class:list={{ small: p.small }}>{p.text}</span>
              </p>
              {i < pains.length - 1 && (
                <svg class="arrow" viewBox="0 0 100 12" preserveAspectRatio="none" aria-hidden="true">
                  <path d="M0 6 H96 M90 1 L97 6 L90 11" fill="none" stroke="currentColor" stroke-width="1.2" vector-effect="non-scaling-stroke" data-chain-arrow />
                </svg>
              )}
            </li>
          ))
        }
      </ol>
    </section>

    <section class="container" aria-labelledby="insights">
      <SectionTitle marker={marker} led id="insights">Key Insights</SectionTitle>
      <ul class="venn" aria-label="Research sources" data-stagger="0.14">
        {
          sources.map((s) => (
            <li class={s.tone}>
              <strong>{s.title}</strong>
              <span>{s.text}</span>
            </li>
          ))
        }
      </ul>
      <ul class="needs" aria-label="What instructors need" data-stagger="0.07">
        {
          needs.map((n) => (
            <li>
              <Img src={n.icon} alt="" sizes="67px" />
              <span>{n.label}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="container stack" aria-labelledby="ideation">
      <SectionTitle marker={marker} led id="ideation">Ideation</SectionTitle>
      <div data-reveal><Img src="prisma/ideation.jpg" alt="Sheet of concept sketches exploring many portable speaker forms" /></div>
      <div data-reveal><Img src="prisma/ideation-handles.png" alt="Refined sketches of the triangular speaker with its handle" /></div>
    </section>

    <section class="container" aria-labelledby="branding">
      <SectionTitle marker={marker} led id="branding">Branding</SectionTitle>
      <div class="brand">
        <div class="logo" data-reveal>
          <Img src="prisma/logo.jpg" alt="Prisma logo with the tagline Protect your voice. Amplify the fun" sizes="380px" />
        </div>
        <ul class="swatches" aria-label="Color palette. Select a colour to copy its hex code." data-swatches>
          {
            swatches.map((c) => (
              <li>
                <button type="button" class="swatch" data-hex={c} data-cursor="Copy" aria-label={`Copy ${c}`}>
                  <span class="dot" style={`background: ${c}`} />
                  <span class="hex">{c.slice(1)}</span>
                </button>
              </li>
            ))
          }
        </ul>
        <div class="type" data-stagger="0.12">
          <figure>
            <span class="aa" aria-hidden="true">Aa</span>
            <figcaption>Montserrat</figcaption>
          </figure>
          <figure class="sans3">
            <span class="aa" aria-hidden="true">Aa</span>
            <figcaption>Source Sans 3</figcaption>
          </figure>
        </div>
        <div class="led-frame moodboard" data-reveal>
          <Img src="prisma/moodboard.png" alt="Prisma moodboard: disco ball, marble sculpture, dancers, cassette tapes and neon light" />
        </div>
      </div>
      <p class="toast" role="status" aria-live="polite" data-toast></p>
    </section>

    <section class="container" aria-labelledby="cad">
      <SectionTitle marker={marker} led id="cad">CAD</SectionTitle>
      <div data-reveal>
        <Img src="prisma/cad.png" alt="CAD renders of the speaker: three-quarter view with handle, top view and both triangular end caps" />
      </div>
    </section>

    <section class="proto" aria-labelledby="proto" data-hscroll>
      <div class="container">
        <SectionTitle marker={marker} led id="proto">Proto</SectionTitle>
      </div>
      <div class="proto-viewport">
        <ul class="proto-track" data-hscroll-track>
          {
            protoAlts.map((alt, i) => (
              <li>
                <Img
                  src={`prisma/proto-${String(i + 1).padStart(2, '0')}.png`}
                  alt={alt}
                  sizes="(min-width: 900px) 32vw, (min-width: 600px) 45vw, 92vw"
                />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="container" aria-labelledby="final">
      <SectionTitle marker={marker} led id="final">Final Functional Prototype</SectionTitle>
      <div class="gallery" data-stagger="0.07">
        <div class="side">
          {gallerySmall.left.map((g) => <Img src={g.src} alt={g.alt} sizes="(min-width: 1280px) 180px, 30vw" />)}
        </div>
        <div class="main">
          <Img
            src="prisma/final-main.jpg"
            alt="Prisma prototype glowing with RGB light against a purple backdrop"
            sizes="(min-width: 1280px) 760px, (min-width: 800px) 60vw, 100vw"
          />
        </div>
        <div class="side">
          {gallerySmall.right.map((g) => <Img src={g.src} alt={g.alt} sizes="(min-width: 1280px) 180px, 30vw" />)}
        </div>
      </div>
      <div class="explode">
        <div data-reveal><Img src="prisma/render.jpg" alt="Render of Prisma with its handle up and RGB light strip" sizes="(min-width: 1280px) 431px, 36vw" /></div>
        <div data-reveal>
          <Img src="prisma/exploded.jpg" alt="Exploded view of Prisma showing handle, mesh, frame, LED strip, drivers, battery and circuit board" sizes="(min-width: 1280px) 765px, 64vw" />
        </div>
      </div>
    </section>

    <section class="container" aria-labelledby="packaging">
      <SectionTitle marker={marker} led id="packaging">Packaging</SectionTitle>
      <div data-reveal>
        <Img src="prisma/packaging.png" alt="Prisma packaging: flat dieline, kraft sleeve, printed box and the speaker inside its packaging" />
      </div>
    </section>

    <section aria-labelledby="app">
      <div class="container">
        <SectionTitle marker={marker} led id="app">App Design</SectionTitle>
      </div>
      <div class="bleed" data-reveal>
        <Img src="prisma/app.jpg" alt="Prisma companion app screens for speaker connection, lighting and music playback" sizes="100vw" />
      </div>
    </section>

    <!-- "INTRODUCING": the film opens from an inset frame to full bleed as it scrolls in. -->
    <section class="film" aria-label="Prisma product video" data-expand>
      <div class="film-frame" data-expand-frame>
        <LazyVideo src="/video/prisma.mp4" poster="/video/prisma-poster.jpg" width={1280} height={609} label="Prisma product video" />
      </div>
    </section>

    <section class="bleed studio" aria-label="Prisma in use" data-reveal>
      <Img src="prisma/studio.jpg" alt="Prisma speaker glowing on the floor of a dance studio during a class" sizes="100vw" />
    </section>
  </div>

  <NextProject current="prisma" />
</Base>

<style>
  .case {
    margin-top: var(--section-gap);
  }

  /* Hero: RGB light sweep across the glowing letters (overlay blend, masked to the lettering band). */
  .sweep {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    mix-blend-mode: overlay;
    -webkit-mask-image: linear-gradient(to bottom, #000 8%, #000 52%, transparent 74%);
    mask-image: linear-gradient(to bottom, #000 8%, #000 52%, transparent 74%);
  }

  .sweep span {
    position: absolute;
    inset: -60% -20%;
    background: conic-gradient(from 90deg, transparent 0 18%, #dd1886 24%, #7d4c9e 30%, #3e82c4 36%, #2ee6c9 42%, #d5ee74 48%, transparent 56% 100%);
    filter: blur(30px);
    opacity: 0.85;
    animation: sweep-spin 11s linear infinite;
  }

  @keyframes sweep-spin {
    to {
      transform: rotate(1turn);
    }
  }

  /* User research */
  .research {
    display: grid;
    grid-template-columns: minmax(0, 335fr) minmax(0, 852fr);
    gap: clamp(24px, 3vw, 40px);
  }

  .research-text {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
  }

  .research-text :global(.section-title) {
    font-size: clamp(2rem, 1.35rem + 3vw, 4rem);
  }

  .research-text :global(.section-title .text) {
    min-width: 0;
  }

  .flow {
    margin-top: clamp(32px, 5vw, 60px);
  }

  .pains {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px clamp(40px, 5vw, 72px);
    margin-top: 40px;
    padding: 0;
    list-style: none;
    color: var(--ink-2);
  }

  .pains li {
    position: relative;
    display: flex;
    gap: clamp(16px, 2.4vw, 32px);
  }

  .pains .num {
    flex: none;
    display: grid;
    place-items: center;
    width: 49px;
    height: 49px;
    border-radius: 50%;
    background: #fde9e0;
    color: var(--ink);
    font-weight: 600;
  }

  .pains strong {
    color: var(--ink);
    font-weight: 600;
  }

  .pains .small {
    font-size: 16px;
  }

  /* Connector drawn between steps (1 -> 2 -> 3). */
  .arrow {
    position: absolute;
    top: 18px;
    right: calc(-1 * clamp(40px, 5vw, 72px) + 6px);
    width: calc(clamp(40px, 5vw, 72px) - 12px);
    height: 12px;
    color: var(--prisma);
    overflow: visible;
  }

  /* Key insights: three overlapping circles */
  .venn {
    display: flex;
    justify-content: center;
    padding: 20px 0 clamp(40px, 8vw, 110px);
    list-style: none;
    color: var(--ink-2);
  }

  .venn li {
    --size: clamp(150px, 26vw, 284px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: var(--size);
    height: var(--size);
    padding: calc(var(--size) * 0.1);
    border-radius: 50%;
    text-align: center;
    font-size: clamp(0.8125rem, 0.6rem + 0.9vw, 1.25rem);
    line-height: 1.5;
    mix-blend-mode: multiply;
  }

  .venn li + li {
    margin-left: calc(var(--size) * -0.145);
  }

  .venn .lilac {
    background: #ede7f1;
  }

  .venn .peach {
    background: #fce5d6;
  }

  .venn strong {
    color: var(--ink);
    font-weight: 600;
  }

  .needs {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 24px 16px;
    padding: clamp(28px, 5vw, 62px) clamp(16px, 2vw, 24px) clamp(28px, 3.4vw, 44px);
    border: 1px solid var(--line);
    border-radius: 33px;
    list-style: none;
    color: var(--ink-2);
    text-align: center;
  }

  .needs li {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 20px;
  }

  .needs :global(img) {
    width: 67px;
  }

  /* Branding */
  .brand {
    display: grid;
    justify-items: center;
    gap: clamp(28px, 4vw, 48px);
  }

  .logo {
    width: min(380px, 80%);
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 20px;
    width: 100%;
    list-style: none;
  }

  .swatch {
    display: grid;
    justify-items: center;
    gap: 18px;
    width: 100%;
    padding: 8px 0;
    border: 0;
    background: none;
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: clamp(0.75rem, 0.6rem + 0.6vw, 1.125rem);
    letter-spacing: 0.06em;
    cursor: copy;
  }

  .dot {
    display: block;
    width: min(133px, 100%);
    aspect-ratio: 1;
    border-radius: 50%;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .swatch:hover .dot,
  .swatch:focus-visible .dot {
    transform: scale(1.06);
  }

  .type {
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 100%;
    color: var(--ink-2);
    text-align: center;
  }

  .type figure {
    display: grid;
    justify-items: center;
  }

  .aa {
    color: var(--ink);
    font-size: clamp(4.5rem, 2.5rem + 7vw, 8rem);
    line-height: 1;
  }

  .type figcaption {
    margin-top: 12px;
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .sans3 .aa {
    font-family: 'Source Sans 3', sans-serif;
  }

  /* Rotating RGB border: the LED strip motif around framed media (transform-only animation). */
  .led-frame {
    position: relative;
    width: 100%;
    padding: 3px;
    overflow: hidden;
    border-radius: calc(var(--radius) + 3px);
    isolation: isolate;
  }

  .led-frame::before {
    content: '';
    position: absolute;
    inset: -50%;
    z-index: -1;
    background: conic-gradient(#dd1886, #7d4c9e, #3e82c4, #2ee6c9, #d5ee74, #dd1886);
    animation: sweep-spin 6s linear infinite;
  }

  .led-frame :global(img) {
    width: 100%;
    border-radius: var(--radius);
  }

  .toast {
    position: fixed;
    left: 50%;
    bottom: 28px;
    z-index: 60;
    padding: 12px 18px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0;
    transform: translate(-50%, 16px);
    transition:
      opacity 0.4s ease,
      transform 0.6s var(--ease-out);
    pointer-events: none;
  }

  .toast:global(.is-on) {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  /* Proto: horizontal track (pinned and scrubbed on desktop, swipeable on touch). */
  .proto-viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-inline: var(--gutter);
  }

  .proto-viewport::-webkit-scrollbar {
    display: none;
  }

  .proto-track {
    display: flex;
    gap: 16px;
    width: max-content;
    list-style: none;
  }

  .proto-track li {
    flex: none;
    width: clamp(260px, 32vw, 520px);
    scroll-snap-align: start;
  }

  .proto-track :global(img) {
    width: 100%;
    border-radius: 20px;
  }

  /* Pinned: fill the viewport and centre the track vertically. */
  .proto:global(.hscroll-on) {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100vh;
  }

  .proto:global(.hscroll-on) .proto-viewport {
    overflow: visible;
  }

  .proto:global(.hscroll-on) .proto-track li {
    width: clamp(320px, 40vw, 640px);
  }

  /* Final prototype gallery: small stacks either side of the hero shot */
  .gallery {
    display: grid;
    grid-template-columns: minmax(0, 180fr) minmax(0, 759fr) minmax(0, 178fr);
    gap: clamp(8px, 1.2vw, 16px);
    align-items: start;
    padding-inline: clamp(0px, 1vw, 12px);
  }

  .side {
    display: grid;
    gap: clamp(8px, 1.1vw, 14px);
  }

  .gallery :global(img) {
    width: 100%;
  }

  .explode {
    display: grid;
    grid-template-columns: minmax(0, 431fr) minmax(0, 765fr);
    align-items: center;
    gap: 8px;
    margin-top: clamp(32px, 5vw, 70px);
  }

  /* Film expands to full bleed */
  .film {
    margin-top: clamp(32px, 5vw, 70px);
  }

  .film-frame {
    overflow: hidden;
  }

  :global(.js:not(.reduced-motion)) .film-frame {
    clip-path: inset(0 8% round 28px);
  }

  .studio {
    margin-top: 0;
  }

  .case > .studio {
    margin-top: clamp(40px, 3vw, 40px);
  }

  @media (max-width: 800px) {
    .research {
      grid-template-columns: 1fr;
    }

    .pains {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .arrow {
      top: auto;
      bottom: -34px;
      left: 24px;
      right: auto;
      width: 28px;
      height: 12px;
      transform: rotate(90deg);
      transform-origin: left center;
    }

    .needs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 32px;
    }

    .swatches {
      gap: 10px;
    }

    .swatch {
      gap: 10px;
    }

    .gallery {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      padding-inline: 0;
    }

    .gallery .main {
      grid-column: 1 / -1;
      order: -1;
    }

    .side {
      display: contents;
    }

    .explode {
      grid-template-columns: 1fr;
    }

    .explode > :first-child {
      width: 70%;
      justify-self: center;
    }
  }

  @media (max-width: 480px) {
    .needs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
