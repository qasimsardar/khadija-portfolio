---
import '@fontsource/source-sans-3/400.css';
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import SectionTitle from '../components/SectionTitle.astro';
import LazyVideo from '../components/LazyVideo.astro';
import CaseHero from '../components/case/CaseHero.astro';
import MetaStrip from '../components/case/MetaStrip.astro';
import NextProject from '../components/case/NextProject.astro';
import { projects } from '../data/projects';

const project = projects.find((p) => p.slug === 'prisma')!;
const marker = '#fce5d6';
const pains = [
  // The first description is set at 16px in the Figma file; the other two are 20px.
  { title: 'Loud Music', text: 'Energetic music creates a loud environment', small: true },
  { title: 'Increased Vocal Effort', text: 'Repeated shouting can lead to vocal fatigue and discomfort' },
  { title: 'Voice Strain', text: 'Instructors have to speak louder to be heard over the music' },
];
const sources = [
  { title: 'Surveys', text: 'User preferences and behaviors', tone: 'lilac' },
  { title: 'Reddit', text: 'Real-world experiences', tone: 'peach' },
  { title: 'Instructor Insights', text: 'First-hand observations', tone: 'lilac' },
];
const needs = [
  { icon: 'prisma/icon-sound.png', label: 'Clear, Powerful Sound' },
  { icon: 'prisma/icon-mic.png', label: 'Audible Instructions' },
  { icon: 'prisma/icon-portable.png', label: 'Portability' },
  { icon: 'prisma/icon-controls.png', label: 'Less Manual Adjustment' },
  { icon: 'prisma/icon-battery.png', label: 'Long Battery Life' },
];
const swatches = ['#434B9F', '#DD1886', '#AC4396', '#7D4C9E', '#3E82C4'];
const protoAlts = [
  'Printed speaker housing panels and handle laid out on a workbench',
  'Handle frame and perforated speaker shell before assembly',
  'Speaker end cap next to a can of Krylon Fusion satin black spray paint',
  'Sewing the speaker mesh cover on a sewing machine',
  'Fitting the circuit board and speaker drivers into the housing',
  'Battery pack and two speaker drivers mounted in their enclosures',
  'Testing the LED strip inside the translucent handle frame',
  'Spray-painting the mesh cover',
  'Mesh cover wrapped over the triangular speaker body',
  'Speaker body fully covered in black mesh',
  'Wiring the electronics into the speaker shell',
  'Electronics, battery and drivers assembled inside the housing',
];
const protoSlides = [...protoAlts, ...protoAlts];
const gallerySmall = {
  left: [
    { src: 'prisma/final-l1.jpg', alt: 'Final Prisma prototype in black with a white frame, front three-quarter view' },
    { src: 'prisma/final-l2.jpg', alt: 'Final Prisma prototype seen from the end cap with its handle' },
    { src: 'prisma/final-l3.jpg', alt: 'Final Prisma prototype standing upright on its triangular end' },
  ],
  right: [
    { src: 'prisma/final-r1.jpg', alt: 'Prisma prototype lit with RGB LEDs on a blue backdrop' },
    { src: 'prisma/final-r2.jpg', alt: 'Underside of the Prisma prototype glowing with RGB light' },
    { src: 'prisma/final-r3.jpg', alt: 'Prisma prototype end view with LEDs glowing' },
  ],
};
// App design: screens exported from Figma at 1x, upscaled 2x for the image pipeline (src/assets/prisma/screens).
const screen = (name: string) => `prisma/screens/${name}.webp`;
const overview = [
  { label: 'Challenge', text: 'Fitness and dance instructors shout over loud music for hours, which strains their voice and still leaves the back of the room guessing.' },
  { label: 'Solution', text: 'A portable triangular speaker with hands-free voice amplification and RGB lighting, plus a companion app that controls it all from one screen.' },
  { label: 'My role', text: 'User research, ideation, branding, CAD, a working prototype, packaging, and the UX and UI of the companion app.' },
];
const uxGoals = [
  { title: 'Hands-free first', text: 'Voice lowers the music automatically, with no tap needed.' },
  { title: 'Glanceable', text: 'Big icons and states that read from across the room.' },
  { title: 'One tap away', text: 'Music, light, mic and timer are each one tap from home.' },
  { title: 'Built for low light', text: 'A dark UI that suits a dimmed studio.' },
];
const onboarding = [
  { file: 'splash', label: 'Splash', alt: 'Prisma splash screen with the gradient P logo on charcoal' },
  { file: 'login', label: 'Sign in', alt: 'Login screen with email and password fields, a gradient Sign in button and Continue as a Guest' },
  { file: 'signup', label: 'Create account', alt: 'Create your account screen with email, password and confirm password fields' },
  { file: 'home', label: 'Home', alt: 'Home screen showing the connected speaker and quick controls' },
];
const callouts = [
  { y: 12, side: 'left', title: 'Connection status', text: 'Confirms the speaker is paired and voice-over-music is on.' },
  { y: 36, side: 'right', title: 'Quick controls', text: 'Music, Light, Microphone and Timer as large tiles.' },
  { y: 56, side: 'left', title: 'Voice-over feedback', text: 'Shows live when the mic is listening and music is lowered.' },
  { y: 73, side: 'right', title: 'Playback', text: 'Play, pause and volume without leaving home.' },
  { y: 85, side: 'left', title: 'Battery', text: 'Charge level so the speaker never dies mid-class.' },
  { y: 97, side: 'right', title: 'Tab bar', text: 'Five destinations, always within thumb reach.' },
];
const features = [
  {
    file: 'music',
    color: '#dd1886',
    title: 'Music',
    alt: 'Music screen: now playing card with a gradient ring, waveform progress, transport controls, music volume and voice-over feedback',
    text: 'A now-playing card with a waveform progress bar and oversized transport controls that are easy to hit between moves.',
    points: ['Shuffle, skip and repeat in one row', 'Music volume shown as a percentage', 'Voice-over status sits right under the player'],
  },
  {
    file: 'lights',
    color: '#7d4c9e',
    title: 'Lights',
    alt: 'Lights screen: a glowing bulb inside a gradient ring with hue and saturation sliders',
    text: 'The RGB LED strip on the speaker is tuned with a hue slider and a saturation slider, so the light can match the mood of each song.',
    points: ['Live colour name next to the hue slider', 'Glowing ring previews the current colour', 'Two sliders instead of a fiddly colour picker'],
  },
  {
    file: 'mic',
    color: '#3e82c4',
    title: 'Microphone',
    alt: 'Microphone screen: a large mic icon, mute state, microphone volume slider and voice-over feedback card',
    text: 'The heart of Prisma. When the mic hears the instructor, the music ducks; when they stop talking, it comes back up on its own.',
    points: ['Clear muted and active states', 'Microphone volume with a plain-language hint', 'Voice-over feedback explains what the speaker is doing'],
  },
  {
    file: 'timer',
    color: '#2ee6c9',
    title: 'Timer',
    alt: 'Timer screen: a 10:00 countdown ring with Start, Pause and Reset buttons and an auto lower volume toggle',
    text: 'An interval timer for rounds and sets, with the option to lower the music automatically while it runs.',
    points: ['Start, Pause and Reset as large pills', 'Repeat for one to three sessions', 'Auto lower volume during the timer'],
  },
];
const pairs = [
  {
    title: 'Setting a timer',
    text: 'Tap “Set timer duration” and a scroll wheel picks the length, with the selected time framed in the brand gradient. Session chips repeat the timer for back-to-back rounds.',
    a: { file: 'timer', alt: 'Timer screen with Set timer duration row' },
    b: { file: 'timer-duration', alt: 'Set a Timer Duration screen with a time wheel showing 00:10:00 selected and session count chips' },
  },
  {
    title: 'Profile and accounts',
    text: 'The menu holds account settings, language, favourites and history, and lets studios that share a speaker switch between instructor profiles.',
    a: { file: 'menu', alt: 'Hamburger menu with the profile Emma Grey, a switch account option and settings list' },
    b: { file: 'account', alt: 'Account screen with profile photo, name, email, user name, password and Save changes button' },
  },
];
const uiColors = [
  { name: 'Surface', value: '#1f1f22' },
  { name: 'Card', value: '#2e2e31' },
  { name: 'Magenta', value: '#dd1886' },
  { name: 'Violet', value: '#7d4c9e' },
  { name: 'Blue', value: '#3e82c4' },
  { name: 'Gradient', value: 'linear-gradient(90deg, #dd1886, #3e82c4)' },
];
const wallCols = [
  ['music', 'login', 'timer', 'account'],
  ['home', 'lights', 'menu', 'signup'],
  ['mic', 'timer-duration', 'splash', 'music'],
  ['account', 'lights', 'home', 'mic'],
  ['signup', 'timer', 'music', 'menu'],
];
---

<Base
  page="prisma"
  title="Prisma"
  accent={project.accent}
  progress
  navOnDark
  ogImage="prisma/hero.jpg"
  description="PRISMA is a portable, multifunctional speaker for fitness and dance instructors, with a companion app that controls its sound, RGB lighting, hands-free voice amplification and class timer."
>
  <CaseHero project={project} dark>
    <div slot="overlay" class="sweep" aria-hidden="true"><span></span></div>
  </CaseHero>
  <MetaStrip project={project} />

  <div class="case">
    <section class="container overview" aria-label="Project overview">
      <dl class="ov-grid" data-stagger="0.1">
        {
          overview.map((o) => (
            <div class="ov-item">
              <dt class="label">{o.label}</dt>
              <dd>{o.text}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="container" aria-labelledby="research">
      <div class="research">
        <div class="research-text">
          <SectionTitle marker={marker} led id="research">User Research</SectionTitle>
          <p class="copy" data-reveal>
            <strong>Zumba instructors</strong> lead energetic group classes, using <strong>music</strong> to <strong>motivate</strong>
            participants while giving <strong>verbal instructions</strong>. They <strong>constantly move</strong> and demonstrate
            exercises, often needing <strong>portable audio equipment</strong> and <strong>clear voice projection.</strong>
          </p>
        </div>
        <div data-reveal>
          <Img
            src="prisma/research-instructor.jpg"
            alt="Sketch of a dance instructor wearing a headset microphone, leading a class"
            sizes="(min-width: 1280px) 852px, (min-width: 800px) 67vw, 100vw"
          />
        </div>
      </div>
      <div class="flow" data-reveal>
        <Img src="prisma/research-flow.jpg" alt="Sketches showing a loud speaker, an instructor shouting over it, and resulting voice strain" />
      </div>
      <ol class="pains" data-chain>
        {
          pains.map((p, i) => (
            <li data-chain-step>
              <span class="num" aria-hidden="true">
                {i + 1}
              </span>
              <p>
                <strong>{p.title}</strong>
                <br />
                <span class:list={{ small: p.small }}>{p.text}</span>
              </p>
              {i < pains.length - 1 && (
                <svg class="arrow" viewBox="0 0 100 12" preserveAspectRatio="none" aria-hidden="true">
                  <path d="M0 6 H96 M90 1 L97 6 L90 11" fill="none" stroke="currentColor" stroke-width="1.2" vector-effect="non-scaling-stroke" data-chain-arrow />
                </svg>
              )}
            </li>
          ))
        }
      </ol>
    </section>

    <section class="container" aria-labelledby="insights">
      <SectionTitle marker={marker} led id="insights">Key Insights</SectionTitle>
      <ul class="venn" aria-label="Research sources" data-pr-venn>
        {
          sources.map((s) => (
            <li class={s.tone}>
              <strong>{s.title}</strong>
              <span>{s.text}</span>
            </li>
          ))
        }
      </ul>
      <ul class="needs" aria-label="What instructors need" data-pr-needs>
        {
          needs.map((n) => (
            <li>
              <Img src={n.icon} alt="" sizes="67px" />
              <span>{n.label}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="container stack" aria-labelledby="ideation">
      <SectionTitle marker={marker} led id="ideation">Ideation</SectionTitle>
      <div data-reveal="clip"><Img src="prisma/ideation.jpg" alt="Sheet of concept sketches exploring many portable speaker forms" /></div>
      <div data-reveal="clip"><Img src="prisma/ideation-handles.png" alt="Refined sketches of the triangular speaker with its handle" /></div>
    </section>

    <section class="container" aria-labelledby="branding">
      <SectionTitle marker={marker} led id="branding">Branding</SectionTitle>
      <div class="brand">
        <div class="logo" data-reveal><div data-pr-logo>
          <Img src="prisma/logo.jpg" alt="Prisma logo with the tagline Protect your voice. Amplify the fun" sizes="380px" /></div>
        </div>
        <ul class="swatches" aria-label="Color palette. Select a colour to copy its hex code." data-swatches>
          {
            swatches.map((c) => (
              <li>
                <button type="button" class="swatch" data-hex={c} data-cursor="Copy" aria-label={`Copy ${c}`}>
                  <span class="dot" style={`background: ${c}`} />
                  <span class="hex">{c.slice(1)}</span>
                </button>
              </li>
            ))
          }
        </ul>
        <div class="type" data-stagger="0.12">
          <figure>
            <span class="aa" aria-hidden="true">Aa</span>
            <figcaption>Montserrat</figcaption>
          </figure>
          <figure class="sans3">
            <span class="aa" aria-hidden="true">Aa</span>
            <figcaption>Source Sans 3</figcaption>
          </figure>
        </div>
        <div class="led-frame moodboard" data-reveal>
          <Img src="prisma/moodboard.png" alt="Prisma moodboard: disco ball, marble sculpture, dancers, cassette tapes and neon light" />
        </div>
      </div>
      <p class="toast" role="status" aria-live="polite" data-toast></p>
    </section>

    <section class="container" aria-labelledby="cad">
      <SectionTitle marker={marker} led id="cad">CAD</SectionTitle>
      <div class="cad-frame" data-reveal="clip" data-tilt="3">
        <Img src="prisma/cad.png" alt="CAD renders of the speaker: three-quarter view with handle, top view and both triangular end caps" />
      </div>
    </section>

    <section class="proto" aria-labelledby="proto">
      <div class="proto-head container">
        <SectionTitle marker={marker} led id="proto">Making of Functional Prototype</SectionTitle>
        <button class="proto-toggle label" type="button" data-proto-toggle aria-pressed="false">Pause motion</button>
      </div>
      <div class="proto-viewport" data-proto-viewport>
        <ul class="proto-track" data-proto-track>
          {
            protoSlides.map((alt, i) => (
              <li aria-hidden={i >= protoAlts.length ? 'true' : undefined}>
                <Img
                  src={`prisma/proto-${String((i % protoAlts.length) + 1).padStart(2, '0')}.png`}
                  alt={i < protoAlts.length ? alt : ''}
                  sizes="(min-width: 900px) 32vw, (min-width: 600px) 45vw, 92vw"
                />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="container" aria-labelledby="final">
      <SectionTitle marker={marker} led id="final">Final Functional Prototype</SectionTitle>
      <div class="gallery" data-stagger="0.07">
        <div class="side">
          {gallerySmall.left.map((g) => <Img src={g.src} alt={g.alt} sizes="(min-width: 1280px) 180px, 30vw" />)}
        </div>
        <div class="main" data-tilt="5">
          <Img
            src="prisma/final-main.jpg"
            alt="Prisma prototype glowing with RGB light against a purple backdrop"
            sizes="(min-width: 1280px) 760px, (min-width: 800px) 60vw, 100vw"
          />
        </div>
        <div class="side">
          {gallerySmall.right.map((g) => <Img src={g.src} alt={g.alt} sizes="(min-width: 1280px) 180px, 30vw" />)}
        </div>
      </div>
      <div class="explode">
        <div data-reveal><div data-float="30"><Img src="prisma/render.jpg" alt="Render of Prisma with its handle up and RGB light strip" sizes="(min-width: 1280px) 431px, 36vw" /></div></div>
        <div data-reveal data-pr-explode>
          <Img src="prisma/exploded.jpg" alt="Exploded view of Prisma showing handle, mesh, frame, LED strip, drivers, battery and circuit board" sizes="(min-width: 1280px) 765px, 64vw" />
        </div>
      </div>
    </section>

    <section class="container" aria-labelledby="packaging">
      <SectionTitle marker={marker} led id="packaging">Packaging</SectionTitle>
      <div data-reveal="clip">
        <Img src="prisma/packaging.png" alt="Prisma packaging: flat dieline, kraft sleeve, printed box and the speaker inside its packaging" />
      </div>
    </section>

    <!-- App Design -->
    <section class="app" aria-labelledby="app">
      <div class="app-glow" aria-hidden="true" data-parallax="0.18"><span></span></div>

      <div class="container app-intro">
        <SectionTitle marker={marker} led id="app">App Design</SectionTitle>
        <div class="app-lead">
          <p class="lead" data-reveal>
            The speaker is only half of the product. The <strong>Prisma companion app</strong> puts sound, light, voice and
            timing on one screen, so an instructor can change the class without stopping the class.
          </p>
          <ul class="ux-goals" aria-label="UX goals for the app" data-stagger="0.08">
            {
              uxGoals.map((g, i) => (
                <li>
                  <span class="label goal-num">{String(i + 1).padStart(2, '0')}</span>
                  <strong>{g.title}</strong>
                  <span>{g.text}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="container app-hero" data-pr-apphero>
        <div class="app-hero-tilt" data-tilt="4">
          <Img src="prisma/app.jpg" alt="Prisma companion app screens for speaker connection, lighting and music playback" sizes="(min-width: 1280px) 1180px, 100vw" quality={88} />
        </div>
      </div>

      <!-- 1. Onboarding flow -->
      <div class="container app-block">
        <header class="block-head">
          <p class="label kicker">01 · Onboarding</p>
          <h3 class="block-title" data-reveal>From splash screen to class in seconds</h3>
          <p class="copy" data-reveal>
            The splash screen hands straight over to sign in. New instructors can create an account, or skip it entirely and
            <strong>continue as a guest</strong> to pair the speaker before a class starts.
          </p>
        </header>
        <ol class="flow-row" data-pr-flow>
          {
            onboarding.map((s, i) => (
              <li class="flow-step">
                <div class="device" data-pr-phone>
                  <Img src={screen(s.file)} alt={s.alt} sizes="(min-width: 1100px) 230px, (min-width: 700px) 22vw, 44vw" quality={90} />
                </div>
                <p class="label step-label">
                  <span>{String(i + 1).padStart(2, '0')}</span> {s.label}
                </p>
                {i < onboarding.length - 1 && (
                  <svg class="flow-arrow" viewBox="0 0 100 12" preserveAspectRatio="none" aria-hidden="true">
                    <path d="M0 6 H96 M90 1 L97 6 L90 11" fill="none" stroke="currentColor" stroke-width="1.4" vector-effect="non-scaling-stroke" data-pr-arrow />
                  </svg>
                )}
              </li>
            ))
          }
        </ol>
      </div>

      <!-- 2. Home dashboard, annotated -->
      <div class="container app-block">
        <header class="block-head center">
          <p class="label kicker">02 · Home dashboard</p>
          <h3 class="block-title" data-reveal>Everything the speaker does, one glance away</h3>
        </header>
        <div class="anatomy" data-pr-anatomy>
          <div class="device device-lg" data-tilt="6">
            <Img src={screen('home')} alt="Prisma home screen: speaker connected, quick tiles for music, light, microphone and timer, voice-over feedback, playback and battery" sizes="(min-width: 900px) 300px, 60vw" quality={90} />
          </div>
          <ul class="callouts">
            {
              callouts.map((c) => (
                <li class:list={['callout', c.side]} style={`--y: ${c.y}%`} data-pr-callout>
                  <span class="callout-line" aria-hidden="true"></span>
                  <span class="callout-dot" aria-hidden="true"></span>
                  <span class="callout-text">
                    <strong>{c.title}</strong>
                    <span>{c.text}</span>
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- 3. Feature walkthrough: the phone stays put while its screen changes to match the feature text beside it. -->
      <div class="container app-block">
        <header class="block-head">
          <p class="label kicker">03 · Core features</p>
          <h3 class="block-title" data-reveal>Four controls, built for a room in motion</h3>
        </header>
        <div class="walk" data-pr-walk>
          <div class="walk-stage" aria-hidden="true">
            <div class="walk-sticky">
              <div class="walk-ring" data-pr-ring></div>
              <div class="device device-lg walk-device">
                {features.map((f, i) => <div class:list={['walk-screen', { 'is-active': i === 0 }]} data-pr-screen={i}><Img src={screen(f.file)} alt="" sizes="(min-width: 900px) 300px, 60vw" quality={90} /></div>)}
              </div>
              <ol class="walk-dots">
                {features.map((f, i) => <li class:list={{ 'is-active': i === 0 }} data-pr-dot={i} style={`--c: ${f.color}`}></li>)}
              </ol>
            </div>
          </div>
          <ol class="walk-list">
            {
              features.map((f, i) => (
                <li class="walk-item" data-pr-feature={i} style={`--c: ${f.color}`}>
                  <div class="device walk-inline">
                    <Img src={screen(f.file)} alt={f.alt} sizes="70vw" quality={90} />
                  </div>
                  <p class="label feature-num">{String(i + 1).padStart(2, '0')} / {String(features.length).padStart(2, '0')}</p>
                  <h4 class="feature-title">{f.title}</h4>
                  <p class="copy">{f.text}</p>
                  <ul class="feature-points">
                    {f.points.map((p) => <li>{p}</li>)}
                  </ul>
                </li>
              ))
            }
          </ol>
        </div>
      </div>

      <!-- 4. Secondary flows -->
      <div class="container app-block">
        <header class="block-head">
          <p class="label kicker">04 · Flows</p>
          <h3 class="block-title" data-reveal>Small flows, designed end to end</h3>
        </header>
        <div class="pairs">
          {
            pairs.map((p) => (
              <article class="pair" data-pr-pair>
                <div class="pair-phones">
                  <div class="device pair-a" data-pr-phone>
                    <Img src={screen(p.a.file)} alt={p.a.alt} sizes="(min-width: 900px) 210px, 40vw" quality={90} />
                  </div>
                  <svg class="pair-arrow" viewBox="0 0 60 30" aria-hidden="true">
                    <path d="M2 24 C 18 2, 40 2, 56 16 M48 9 L57 17 L46 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" data-pr-arrow />
                  </svg>
                  <div class="device pair-b" data-pr-phone>
                    <Img src={screen(p.b.file)} alt={p.b.alt} sizes="(min-width: 900px) 210px, 40vw" quality={90} />
                  </div>
                </div>
                <h4 class="pair-title">{p.title}</h4>
                <p class="copy">{p.text}</p>
              </article>
            ))
          }
        </div>
      </div>

      <!-- 5. UI kit, rebuilt live in HTML so the components actually move. -->
      <div class="container app-block">
        <header class="block-head">
          <p class="label kicker">05 · UI kit</p>
          <h3 class="block-title" data-reveal>A dark interface lit like the speaker</h3>
          <p class="copy" data-reveal>
            Charcoal surfaces keep the screen calm in a dim studio. The same magenta-to-blue gradient as the speaker's LED strip
            marks every primary action, so the app and the object read as one product.
          </p>
        </header>
        <div class="kit" data-pr-kit>
          <div class="kit-card kit-colors" data-tilt="5">
            <p class="label">Colour</p>
            <ul>
              {uiColors.map((c) => <li><span class="chip" style={`background: ${c.value}`}></span><span class="label">{c.name}</span></li>)}
            </ul>
          </div>
          <div class="kit-card kit-type" data-tilt="5">
            <p class="label">Type · Montserrat</p>
            <p class="kit-h">Speaker Connected</p>
            <p class="kit-b">Voice-over-music enabled</p>
            <p class="kit-c label">Now playing</p>
          </div>
          <div class="kit-card kit-controls" data-tilt="5">
            <p class="label">Components</p>
            <span class="ui-btn">Sign in</span>
            <div class="ui-row">
              <span class="ui-toggle" data-pr-toggle><span></span></span>
              <span class="ui-badge">Voice detected</span>
            </div>
