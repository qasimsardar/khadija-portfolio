---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Button from '../components/Button.astro';
import { projects } from '../data/projects';
import { site } from '../data/site';

const disciplines = [...new Set(projects.map((p) => p.category))];
---

<Base page="work" title="Work" description="Industrial design and UI/UX projects by Khadija Sardar: Prisma, Tiffin, Pennie, SkilLender and GoSafe.">
  <section class="intro container-wide" aria-labelledby="work-title">
    <p class="label kicker">{site.role}</p>
    <h1 id="work-title" class="display title" data-split="intro">
      Work <span class="count">({String(projects.length).padStart(2, '0')})</span>
    </h1>
    <ul class="disciplines" data-stagger="0.06">
      {disciplines.map((d) => <li class="pill">{d}</li>)}
    </ul>
  </section>

  <section id="research-work" class="work-showcase container-wide" aria-labelledby="research-work-title">
    <div class="showcase-heading"><p class="label kicker">Research · current</p><h2 id="research-work-title">Designing for people, from the first question.</h2></div>
    <article class="research-card" data-reveal>
      <div class="research-index" aria-hidden="true">R<span>01</span></div>
      <div class="research-copy">
        <p class="label research-meta">Iowa State College of Design · 2026—present</p>
        <h3>Undergraduate Research Assistant</h3>
        <p class="copy">{site.about.experience[0].detail}</p>
        <ul class="research-tags"><li class="pill">Human-centered design</li><li class="pill">Pediatric assistive devices</li><li class="pill">Research & prototyping</li></ul>
      </div>
    </article>
  </section>

  <section id="client-work" class="client-showcase container-wide" aria-labelledby="client-work-title">
    <div class="showcase-heading"><p class="label kicker">Selected client work</p><h2 id="client-work-title">Identity and ideas made for the real world.</h2></div>
    <div class="client-logos" data-stagger="0.12">
      <article class="client-logo-card" data-reveal="clip">
        <div class="client-work-image client-work-image--logo"><span class="client-work-number label">01</span><Img src="work/a1-concrete-logo.png" alt="A1 Concrete logo designed for a concrete services business" sizes="(min-width: 800px) 42vw, 92vw" /></div>
        <div class="client-work-copy"><p class="label client-work-category">Brand identity · Logo design</p><h3>A1 Concrete</h3></div>
      </article>
      <article class="client-logo-card" data-reveal="clip">
        <div class="client-work-image"><span class="client-work-number label">02</span><Img src="work/maples-clinic-display.jpg" alt="Maple’s Clinic Visit book display and activity materials placed at a clinic reception counter" sizes="(min-width: 800px) 42vw, 92vw" /></div>
        <div class="client-work-copy"><p class="label client-work-category">Product · Clinic book frame</p><h3>Maple’s Clinic Visit</h3><p class="copy">A book frame for the Maple book series by Bruno Oro, now displayed in <strong>17+ clinics across the U.S.</strong></p></div>
      </article>
    </div>
  </section>

  <!-- Index: hover a row (desktop) and its cover follows the cursor. -->
  <section class="index container-wide" aria-label="Project index" data-index>
    <ul class="rows">
      {
        projects.map((p, i) => (
          <li class="row" data-accent={p.accent} data-index-row={i} style={`--row-accent: ${p.accent}`}>
            {p.href ? (
              <a class="row-link" href={p.href} data-cursor="View">
                <span class="row-num label">{String(i + 1).padStart(2, '0')}</span>
                <span class="row-title">{p.name}</span>
                <span class="row-cat label">{p.category}</span>
                <span class="row-go" aria-hidden="true">→</span>
              </a>
            ) : (
              <div class="row-link is-locked" data-cursor="Soon">
                <span class="row-num label">{String(i + 1).padStart(2, '0')}</span>
                <span class="row-title">{p.name}</span>
                <span class="row-cat label">{p.category}</span>
                <span class="row-go label" aria-label="Case study coming soon">Soon</span>
              </div>
            )}
          </li>
        ))
      }
    </ul>
    <div class="preview" aria-hidden="true" data-preview>
      {
        projects.map((p, i) => (
          <div class="preview-item" data-preview-item={i}>
            <Img src={p.cover.src} alt="" sizes="420px" />
          </div>
        ))
      }
    </div>
  </section>

  <div id="bands" class="bands">
    {
      projects.map((p, i) => {
        const number = String(i + 1).padStart(2, '0');
        // The design alternates image left / image right, starting with the image on the left.
        const side = i % 2 === 0 ? 'image-left' : 'image-right';
        return (
          <section
            class:list={['band', side, `band-${p.slug}`, { dark: p.band.dark }]}
            style={`--band-bg: ${p.band.bg}; --marker: ${p.band.marker}`}
            data-accent={p.accent}
            aria-labelledby={`band-${p.slug}`}
          >
            <div class="media" data-reveal="clip">
              <Img src={p.band.src} alt={p.band.alt} sizes="(min-width: 800px) 67vw, 100vw" />
            </div>
            <div class="text">
              <p class="label num">
                <span class="marker" aria-hidden="true" />
                {number}
              </p>
              <h2 id={`band-${p.slug}`} class="name">
                {p.href ? (
                  <a class="name-link" href={p.href} data-cursor="View">
                    {p.name}
                  </a>
                ) : (
                  p.name
                )}
              </h2>
              <p class="desc">
                {p.mark} {p.description}
              </p>
              {!p.href && <p class="label soon">Case study coming soon</p>}
            </div>
          </section>
        );
      })
    }
  </div>

  <section class="outro container-wide">
    <Button href="/#about">Discover my skills and passions</Button>
  </section>
</Base>

<style>
  .intro {
    display: grid;
    gap: clamp(20px, 3vw, 40px);
    padding-block: clamp(140px, 22vh, 240px) clamp(40px, 6vw, 88px);
  }

  .kicker {
    color: var(--ink-3);
  }

  .title {
    font-size: var(--fs-mega);
    line-height: 0.9;
    letter-spacing: -0.055em;
  }

  .count {
    font-family: var(--font-accent);
    font-style: italic;
    font-size: 0.32em;
    letter-spacing: 0;
    vertical-align: super;
  }

  .disciplines {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
  }

  .disciplines .pill {
    border-color: var(--line);
  }

  .work-showcase,.client-showcase { padding-block:clamp(40px,7vw,92px) var(--section-gap); }
  .showcase-heading { display:grid; grid-template-columns:minmax(180px,.8fr) minmax(0,1.2fr); align-items:end; gap:24px; margin-bottom:clamp(32px,5vw,68px); }
  .showcase-heading .kicker { margin:0; text-transform:uppercase; letter-spacing:.09em; }
  .showcase-heading h2 { max-width:17ch; font-size:var(--fs-h2); font-weight:300; line-height:1.04; letter-spacing:-.045em; }
  .research-card { display:grid; grid-template-columns:minmax(170px,.65fr) minmax(0,1.35fr); align-items:center; gap:clamp(32px,7vw,100px); padding:clamp(26px,5vw,64px); border:1px solid var(--line); border-radius:var(--radius); background:var(--paper-2); }
  .research-index { display:grid; place-items:center; width:min(100%,230px); aspect-ratio:1; border:1px solid color-mix(in srgb,var(--violet) 40%,transparent); border-radius:50%; color:var(--violet); font-size:clamp(5rem,12vw,9rem); font-weight:300; line-height:.8; letter-spacing:-.12em; }
  .research-index span { align-self:start; margin-top:20%; margin-left:-10%; font-family:var(--font-mono); font-size:var(--fs-label); letter-spacing:.08em; }
  .research-meta { margin-bottom:12px; color:var(--ink-3); text-transform:uppercase; letter-spacing:.08em; }
  .research-copy h3 { font-size:var(--fs-h3); font-weight:400; letter-spacing:-.035em; }
  .research-copy .copy { max-width:64ch; margin-top:16px; color:var(--ink-2); }
  .research-tags { display:flex; flex-wrap:wrap; gap:9px; margin-top:24px; list-style:none; }
  .research-tags .pill { border-color:var(--line); }
  .client-showcase { padding-top:0; }
  .client-logos { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:clamp(16px,3vw,40px); }
  .client-logo-card { overflow:hidden; border:1px solid var(--line); border-radius:var(--radius); background:var(--paper-2); }
  .client-work-image { position:relative; display:grid; place-items:center; aspect-ratio:1.35; overflow:hidden; background:#eeeae3; }
  .client-work-image :global(img) { width:100%; height:100%; object-fit:cover; transition:transform .75s var(--ease-out); }
  .client-logo-card:hover .client-work-image :global(img) { transform:scale(1.035); }
  .client-work-image--logo { background:#f4f2ed; }
  .client-work-image--logo :global(img) { width:34%; height:66%; object-fit:contain; }
  .client-work-number { position:absolute; z-index:1; top:14px; left:16px; color:var(--ink-3); }
  .client-work-copy { padding:clamp(18px,2.5vw,30px); }
  .client-work-category { margin-bottom:10px; color:var(--ink-3); text-transform:uppercase; letter-spacing:.08em; }
  .client-work-copy h3 { font-size:var(--fs-h3); font-weight:400; letter-spacing:-.035em; }
  .client-work-copy .copy { max-width:48ch; margin-top:12px; color:var(--ink-2); }
  .client-work-copy .copy strong { color:var(--ink); font-weight:600; }

  /* Index rows */
  .index {
    position: relative;
    padding-bottom: var(--section-gap);
  }

  .rows {
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .row {
    border-bottom: 1px solid var(--line);
  }

  .row-link {
    position: relative;
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) auto 56px;
    align-items: center;
    gap: 16px clamp(16px, 3vw, 48px);
    padding-block: clamp(20px, 2.6vw, 36px);
    isolation: isolate;
  }

  /* Accent wash that wipes in from the left on hover. */
  .row-link::before {
    content: '';
    position: absolute;
    inset: 0 calc(-1 * var(--gutter));
    z-index: -1;
    background: var(--row-accent);
    opacity: 0.12;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform var(--dur-2) var(--ease-out);
  }

  a.row-link:hover::before,
  a.row-link:focus-visible::before {
    transform: scaleX(1);
    transform-origin: left center;
  }

  .row-num,
  .row-cat {
    color: var(--ink-3);
  }

  .row-title {
    font-weight: 300;
    font-size: var(--fs-h2);
    line-height: 1;
    letter-spacing: -0.04em;
    transition: transform var(--dur-2) var(--ease-out);
  }

  a.row-link:hover .row-title {
    transform: translateX(14px);
  }

  .row-go {
    justify-self: end;
    font-size: 1.5rem;
    transition: transform var(--dur-2) var(--ease-out);
  }

  a.row-link:hover .row-go {
    transform: translateX(6px);
  }

  .is-locked .row-title {
    color: var(--ink-3);
  }

  .is-locked .row-go {
    font-size: var(--fs-label);
    color: var(--ink-3);
  }

  .preview {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 40;
    width: clamp(240px, 26vw, 420px);
    aspect-ratio: 4 / 3;
    border-radius: 16px;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
  }

  .preview-item {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .preview-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Bands (the Figma "work" layout) */
  .band {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 858fr) minmax(0, 422fr);
    min-height: clamp(420px, 48vw, 616px);
    background: var(--band-bg);
    color: var(--ink);
    overflow: hidden;
  }

  .band.dark {
    color: #f4f1ea;
    --ink-3: rgba(244, 241, 234, 0.6);
  }

  .band.image-right {
    grid-template-columns: minmax(0, 422fr) minmax(0, 858fr);
  }

  .band.image-right .media {
    order: 2;
  }

  .media {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100%;
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .text {
    align-self: center;
    display: grid;
    gap: 16px;
    padding: 40px var(--gutter) 40px clamp(24px, 3vw, 44px);
  }

  .image-right .text {
    padding: 40px clamp(24px, 3vw, 44px) 40px var(--gutter);
  }

  .num {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .marker {
    width: 14px;
    height: 14px;
    background: var(--marker);
  }

  .name {
    font-weight: 300;
    font-size: var(--fs-h2);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .name-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .desc {
    max-width: 36ch;
    font-size: var(--fs-body);
    line-height: 1.6;
    opacity: 0.85;
  }

  .soon {
    opacity: 0.65;
  }

  .band-tiffin .media :global(img) {
    object-position: right center;
  }

  .band-skillender .media :global(img) {
    object-fit: contain;
  }

  .outro {
    display: flex;
    justify-content: center;
    padding-block: var(--section-gap) 0;
  }

  @media (max-width: 800px) {
    .showcase-heading { grid-template-columns:1fr; }
    .research-card { grid-template-columns:1fr; }
    .research-index { width:150px; font-size:5rem; }
    .client-logos { grid-template-columns:1fr; }
    .row-link {
      grid-template-columns: 40px minmax(0, 1fr) 40px;
    }

    .row-cat {
      display: none;
    }

    .band,
    .band.image-right {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .band.image-right .media {
      order: 0;
    }

    .media :global(img) {
      height: auto;
    }

    .text,
    .image-right .text {
      padding: 28px var(--gutter) 48px;
    }

  }
</style>
