---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Button from '../components/Button.astro';
import { projects } from '../data/projects';
import { site } from '../data/site';

const disciplines = [...new Set(projects.map((p) => p.category))];
---

<Base page="work" title="Work" description="Industrial design and UI/UX projects by Khadija Sardar: Prisma, Tiffin, Pennie, SkilLender and Go Safe.">
  <section class="intro container-wide" aria-labelledby="work-title">
    <p class="label kicker">{site.role}</p>
    <h1 id="work-title" class="display title" data-split="intro">
      Work <span class="count">({String(projects.length).padStart(2, '0')})</span>
    </h1>
    <ul class="disciplines" data-stagger="0.06">
      {disciplines.map((d) => <li class="pill">{d}</li>)}
    </ul>
  </section>

  <!-- Index: hover a row (desktop) and its cover follows the cursor. -->
  <section class="index container-wide" aria-label="Project index" data-index>
    <ul class="rows">
      {
        projects.map((p, i) => (
          <li class="row" data-accent={p.accent} data-index-row={i} style={`--row-accent: ${p.accent}`}>
            {p.href ? (
              <a class="row-link" href={p.href} data-cursor="View">
                <span class="row-num label">{String(i + 1).padStart(2, '0')}</span>
                <span class="row-title">{p.name}</span>
                <span class="row-cat label">{p.category}</span>
                <span class="row-go" aria-hidden="true">→</span>
              </a>
            ) : (
              <div class="row-link is-locked" data-cursor="Soon">
                <span class="row-num label">{String(i + 1).padStart(2, '0')}</span>
                <span class="row-title">{p.name}</span>
                <span class="row-cat label">{p.category}</span>
                <span class="row-go label" aria-label="Case study coming soon">Soon</span>
              </div>
            )}
          </li>
        ))
      }
    </ul>
    <div class="preview" aria-hidden="true" data-preview>
      {
        projects.map((p, i) => (
          <div class="preview-item" data-preview-item={i}>
            <Img src={p.cover.src} alt="" sizes="420px" />
          </div>
        ))
      }
    </div>
  </section>

  <div id="bands" class="bands">
    {
      projects.map((p, i) => {
        const number = String(i + 1).padStart(2, '0');
        // The design alternates image left / image right, starting with the image on the left.
        const side = i % 2 === 0 ? 'image-left' : 'image-right';
        return (
          <section
            class:list={['band', side, `band-${p.slug}`, { dark: p.band.dark }]}
            style={`--band-bg: ${p.band.bg}; --marker: ${p.band.marker}`}
            data-accent={p.accent}
            aria-labelledby={`band-${p.slug}`}
          >
            <div class="media" data-reveal="clip">
              <Img src={p.band.src} alt={p.band.alt} sizes="(min-width: 800px) 67vw, 100vw" />
            </div>
            <div class="text">
              <p class="label num">
                <span class="marker" aria-hidden="true" />
                {number}
              </p>
              <h2 id={`band-${p.slug}`} class="name">
                {p.href ? (
                  <a class="name-link" href={p.href} data-cursor="View">
                    {p.name}
                  </a>
                ) : (
                  p.name
                )}
              </h2>
              <p class="desc">
                {p.mark} {p.description}
              </p>
              {!p.href && <p class="label soon">Case study coming soon</p>}
            </div>
          </section>
        );
      })
    }
  </div>

  <section class="outro container-wide">
    <Button href="/#about">Discover my skills and passions</Button>
  </section>
</Base>

<style>
  .intro {
    display: grid;
    gap: clamp(20px, 3vw, 40px);
    padding-block: clamp(140px, 22vh, 240px) clamp(40px, 6vw, 88px);
  }

  .kicker {
    color: var(--ink-3);
  }

  .title {
    font-size: var(--fs-mega);
    line-height: 0.9;
    letter-spacing: -0.055em;
  }

  .count {
    font-family: var(--font-accent);
    font-style: italic;
    font-size: 0.32em;
    letter-spacing: 0;
    vertical-align: super;
  }

  .disciplines {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
  }

  .disciplines .pill {
    border-color: var(--line);
  }

  /* Index rows */
  .index {
    position: relative;
    padding-bottom: var(--section-gap);
  }

  .rows {
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .row {
    border-bottom: 1px solid var(--line);
  }

  .row-link {
    position: relative;
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) auto 56px;
    align-items: center;
    gap: 16px clamp(16px, 3vw, 48px);
    padding-block: clamp(20px, 2.6vw, 36px);
    isolation: isolate;
  }

  /* Accent wash that wipes in from the left on hover. */
  .row-link::before {
    content: '';
    position: absolute;
    inset: 0 calc(-1 * var(--gutter));
    z-index: -1;
    background: var(--row-accent);
    opacity: 0.12;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform var(--dur-2) var(--ease-out);
  }

  a.row-link:hover::before,
  a.row-link:focus-visible::before {
    transform: scaleX(1);
    transform-origin: left center;
  }

  .row-num,
  .row-cat {
    color: var(--ink-3);
  }

  .row-title {
    font-weight: 300;
    font-size: var(--fs-h2);
    line-height: 1;
    letter-spacing: -0.04em;
    transition: transform var(--dur-2) var(--ease-out);
  }

  a.row-link:hover .row-title {
    transform: translateX(14px);
  }

  .row-go {
    justify-self: end;
    font-size: 1.5rem;
    transition: transform var(--dur-2) var(--ease-out);
  }

  a.row-link:hover .row-go {
    transform: translateX(6px);
  }

  .is-locked .row-title {
    color: var(--ink-3);
  }

  .is-locked .row-go {
    font-size: var(--fs-label);
    color: var(--ink-3);
  }

  .preview {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 40;
    width: clamp(240px, 26vw, 420px);
    aspect-ratio: 4 / 3;
    border-radius: 16px;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
  }

  .preview-item {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .preview-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Bands (the Figma "work" layout) */
  .band {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 858fr) minmax(0, 422fr);
    min-height: clamp(420px, 48vw, 616px);
    background: var(--band-bg);
    color: var(--ink);
    overflow: hidden;
  }

  .band.dark {
    color: #f4f1ea;
    --ink-3: rgba(244, 241, 234, 0.6);
  }

  .band.image-right {
    grid-template-columns: minmax(0, 422fr) minmax(0, 858fr);
  }

  .band.image-right .media {
    order: 2;
  }

  .media {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100%;
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .text {
    align-self: center;
    display: grid;
    gap: 16px;
    padding: 40px var(--gutter) 40px clamp(24px, 3vw, 44px);
  }

  .image-right .text {
    padding: 40px clamp(24px, 3vw, 44px) 40px var(--gutter);
  }

  .num {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .marker {
    width: 14px;
    height: 14px;
    background: var(--marker);
  }

  .name {
    font-weight: 300;
    font-size: var(--fs-h2);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .name-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .desc {
    max-width: 36ch;
    font-size: var(--fs-body);
    line-height: 1.6;
    opacity: 0.85;
  }

  .soon {
    opacity: 0.65;
  }

  .band-tiffin .media :global(img) {
    object-position: right center;
  }

  /* GoSafe: transparent phone cut-out overflows the navy band slightly, as in the design. */
  .band-gosafe .media {
    position: relative;
  }

  .band-gosafe .media :global(img) {
    position: absolute;
    top: -5%;
    left: clamp(16px, 4.3vw, 55px);
    width: auto;
    height: 110%;
    object-fit: contain;
  }

  .band-skillender .media :global(img) {
    object-fit: contain;
  }

  .outro {
    display: flex;
    justify-content: center;
    padding-block: var(--section-gap) 0;
  }

  @media (max-width: 800px) {
    .row-link {
      grid-template-columns: 40px minmax(0, 1fr) 40px;
    }

    .row-cat {
      display: none;
    }

    .band,
    .band.image-right {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .band.image-right .media {
      order: 0;
    }

    .media :global(img) {
      height: auto;
    }

    .text,
    .image-right .text {
      padding: 28px var(--gutter) 48px;
    }

    .band-gosafe .media {
      padding: 32px var(--gutter) 0;
    }

    .band-gosafe .media :global(img) {
      position: static;
      height: auto;
      max-height: 460px;
    }
  }
</style>
