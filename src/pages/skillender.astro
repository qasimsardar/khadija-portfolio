---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import SectionTitle from '../components/SectionTitle.astro';
import MetaStrip from '../components/case/MetaStrip.astro';
import NextProject from '../components/case/NextProject.astro';
import { projects } from '../data/projects';
import '@fontsource/montserrat/700.css';
import '@fontsource/montserrat/800.css';
import '@fontsource/montserrat/900.css';
import '@fontsource/lora/400.css';

const project = projects.find((p) => p.slug === 'skillender')!;
const page = {
  home: 'skillender/homepage.png',
  workshops: 'skillender/workshops.png',
  products: 'skillender/products.png',
  details: 'skillender/product-details.png',
  community: 'skillender/community.png',
};
const stats = [
  { value: 258, suffix: 'M', text: 'children and youth worldwide are not enrolled in school' },
  { value: 773, suffix: 'M', text: 'adults around the world cannot read' },
  { value: 60, prefix: '<', suffix: '%', text: 'enrollment and literacy rates in Pakistan' },
  { value: 2, prefix: '~', suffix: '%', text: 'of Pakistan’s GDP is spent on education' },
];
const benchmarks = [
  { name: 'Self-Help Groups', works: 'Peer-led, community-owned and personal. Members teach each other relevant skills.', improve: 'Irregular meetings and weak organization.' },
  { name: 'Taleemabad', works: 'National-standard textbooks, AI teaching support and modular training.', improve: 'Teaches subjects more than skills, and needs digital access.' },
  { name: 'WWOOF', works: 'A digital platform that connects people in person around hands-on skills.', improve: 'The same model could work for education with a standard program.' },
];
const stakeholders = [
  { level: 'Primary users', title: 'Learners', text: 'Underprivileged teens and adults who never went to school and want income-generating skills.', color: '#FBBA4E' },
  { level: 'Secondary users', title: 'Instructors', text: 'Artisans, craftsmen, professionals, NGOs and community service organizations.', color: '#0B966C' },
  { level: 'Tertiary users', title: 'Community', text: 'Locals who provide space, program directors, store owners in cities and customers.', color: '#FF7C4B' },
];
const colors = [
  { hex: '#0B966C', name: 'Growth', ink: '#fff' },
  { hex: '#FF7C4B', name: 'Craft', ink: '#fff' },
  { hex: '#FBBA4E', name: 'Warmth', ink: '#23263B' },
  { hex: '#313484', name: 'Headlines', ink: '#fff' },
  { hex: '#B2C3F7', name: 'Calm', ink: '#23263B' },
  { hex: '#F7F4F1', name: 'Base', ink: '#23263B' },
];
const hifi = [
  { title: 'Home Page', note: 'A clear mission up front, featured vendors, and the story behind SkilLender.', url: 'skillender.com', src: page.home, dur: 7 },
  { title: 'Workshops Page', note: 'Filter by craft, see who’s teaching and when, and register in one tap.', url: 'skillender.com/workshops', src: page.workshops, dur: 6 },
  { title: 'Products Page', note: 'Every product is handmade by a workshop learner, with the maker’s name on each card.', url: 'skillender.com/products', src: page.products, dur: 6 },
  { title: 'Product Details Page', note: 'Photos, specifications, price in rupees and related items from other makers.', url: 'skillender.com/products/cutting-board', src: page.details, dur: 6 },
  { title: 'Community Page', note: 'A learning inquiry board, a form to share a skill, and color-coded meetups.', url: 'skillender.com/community', src: page.community, dur: 6 },
];
---

<Base
  page="skillender"
  title="SkilLender"
  accent={project.accent}
  progress
  hideFooter
  ogImage="home/skillender-website-mockup.png"
  description="SkilLender is a skill-sharing platform connecting artisans, educators and learners in Pakistan through free hands-on workshops."
>
  <div class="sk">
    <!-- HERO -->
    <header class="intro container-wide" aria-labelledby="case-title">
      <p class="label crumbs"><a class="link-draw" href="/work">Work</a><span aria-hidden="true">/</span><span>UX Design</span></p>
      <div class="intro-copy">
        <h1 id="case-title" class="title" data-split="intro">SkilLender</h1>
        <p class="lead description" data-reveal><strong>SkilLender</strong> is a skill-sharing platform that connects artisans, educators and learners in Pakistan through free hands-on workshops, then sells what students make to fund the next class.</p>
      </div>
    </header>
    <MetaStrip project={project} />

    <div class="container">
      <div class="stage" data-sk-stage>
        <div class="pattern" aria-hidden="true"></div>
        <div class="brand" data-sk-brand><Img src="skillender/logo-mark.png" alt="" sizes="40px" />SkilLender</div>
        <div class="bw l" data-sk-bw>
          <div class="browser"><div class="bar"><i></i><i></i><i></i><span>skillender.com/products</span></div><div class="vp auto" style="--dur:30s"><Img src={page.products} alt="SkilLender products page" sizes="(min-width: 1100px) 380px, 40vw" /></div></div>
        </div>
        <div class="bw r" data-sk-bw>
          <div class="browser"><div class="bar"><i></i><i></i><i></i><span>skillender.com/workshops</span></div><div class="vp auto" style="--dur:28s"><Img src={page.workshops} alt="SkilLender workshops page" sizes="(min-width: 1100px) 380px, 40vw" /></div></div>
        </div>
        <div class="lap" data-sk-lap>
          <div class="laptop"><div class="lid"><div class="vp auto" style="--dur:26s"><Img src={page.home} alt="SkilLender homepage scrolling on a laptop" sizes="(min-width: 1100px) 640px, 86vw" eager quality={88} /></div></div><div class="base"></div></div>
        </div>
      </div>
    </div>

    <!-- PROBLEM / SOLUTION -->
    <section class="container block problem" aria-label="Problem and solution">
      <div>
        <div data-reveal>
          <SectionTitle marker="#0B966C" id="problem">Problem</SectionTitle>
          <p class="copy">In Pakistan, millions of people never get the chance to learn. School is too expensive, too far away, or simply out of reach, and many leave early to work or help at home. Without skills, they stay stuck in low-income work they can’t escape.</p>
        </div>
        <div class="gap" data-reveal>
          <SectionTitle marker="#0B966C" id="solution">Solution</SectionTitle>
          <p class="copy">SkilLender offers free, hands-on workshops taught by local artisans and business owners. In exchange, each student makes three quality products that are sold online and in stores, so the system pays for itself and keeps growing.</p>
        </div>
      </div>
      <div class="tilt" data-sk-tilt>
        <div class="browser"><div class="bar"><i></i><i></i><i></i><span>skillender.com/community</span></div><div class="vp auto" style="--dur:24s"><Img src={page.community} alt="SkilLender community page" sizes="(min-width: 900px) 445px, 92vw" /></div></div>
      </div>
    </section>

    <!-- CHALLENGE -->
    <section class="container block" aria-labelledby="challenge-title">
      <SectionTitle marker="#0B966C" id="challenge-title">The Challenge</SectionTitle>
      <p class="copy narrow" data-reveal>Our brief was the UN’s <strong>SDG 4: Quality Education</strong>. We focused on target 4.4, increasing the number of youth and adults with real job skills, and chose Pakistan as our case study.</p>
      <div class="stats mt" data-stagger="0.1">
        {stats.map((st) => <div class="stat"><b>{st.prefix ?? ''}<span data-count={st.value}>{st.value}</span>{st.suffix}</b><span>{st.text}</span></div>)}
      </div>
    </section>

    <!-- BENCHMARKING -->
    <section class="container block" aria-labelledby="bench-title">
      <SectionTitle marker="#0B966C" id="bench-title">Benchmarking</SectionTitle>
      <p class="copy narrow" data-reveal>We studied existing education services and community programs in Pakistan and abroad to find what works and where the gaps are. Most focus on school subjects and need devices many people can’t afford.</p>
      <ul class="cards mt" data-stagger="0.1">
        {benchmarks.map((b) => <li data-tilt><h3 class="serif">{b.name}</h3><dl><dt>Works well</dt><dd>{b.works}</dd><dt>Could improve</dt><dd>{b.improve}</dd></dl></li>)}
      </ul>
    </section>

    <!-- STAKEHOLDERS -->
    <section class="container block" aria-labelledby="stake-title">
      <SectionTitle marker="#0B966C" id="stake-title">Stakeholders</SectionTitle>
      <ul class="cards" data-stagger="0.1">
        {stakeholders.map((st) => <li data-tilt><span class="num"><span class="dot" style={`background:${st.color}`}></span>{st.level}</span><h3 class="serif">{st.title}</h3><p class="small">{st.text}</p></li>)}
      </ul>
    </section>

    <!-- HOW IT WORKS -->
    <section class="container block" aria-labelledby="how-title">
      <SectionTitle marker="#0B966C" id="how-title">How It Works</SectionTitle>
      <p class="copy narrow" data-reveal>We built a circular system inspired by equipment rental, sliding pay scales, fair-trade shops and the glassblowing “make one, give one” model.</p>
      <div class="loop mt" data-sk-loop>
        <div class="step" data-tilt><div class="ico" style="background:#FBBA4E"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c1-4 4-6 8-6s7 2 8 6"></path></svg></div><h4>Learn for free</h4><p class="small">Students join hands-on workshops at no cost.</p></div>
        <div class="step" data-tilt><div class="ico" style="background:#0B966C"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4z"></path></svg></div><h4>Taught by experts</h4><p class="small">Artisans and business owners teach and rent out their tools.</p></div>
        <div class="step" data-tilt><div class="ico" style="background:#FF7C4B"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7l9-4 9 4-9 4z"></path><path d="M3 7v10l9 4 9-4V7"></path></svg></div><h4>Make three</h4><p class="small">Each student makes three quality products to “pay” for the class.</p></div>
        <div class="step" data-tilt><div class="ico" style="background:#313484"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2.5 11h11L21 7H6.5"></path><circle cx="9" cy="20" r="1.5"></circle><circle cx="18" cy="20" r="1.5"></circle></svg></div><h4>Sold to fund more</h4><p class="small">Products sell online and in stores on a sliding pay scale.</p></div>
      </div>
      <div class="return" data-reveal><span class="spin" aria-hidden="true">↺</span>Sales and donations fund the next workshop, so the system sustains itself.</div>
      <figure class="drawing mt" data-reveal><Img src="skillender/use-case.png" alt="Hand-drawn use case scenario: artisans teach free workshops, students make three products, products sell in cities and donors restart the cycle" sizes="(min-width: 1100px) 1000px, 92vw" quality={90} /></figure>
    </section>

    <!-- LOW-FI BROCHURE (was Sketch Exploration) -->
    <section class="container block" aria-labelledby="lofi-brochure-title">
      <SectionTitle marker="#0B966C" id="lofi-brochure-title">Low-fi Brochure</SectionTitle>
      <div class="spreads" data-stagger="0.14">
        <figure class="lift"><Img src="skillender/brochure-lofi-1.jpg" alt="Low-fidelity brochure spread about business owners, donors, customers, students, stores and employment" sizes="(min-width: 1100px) 560px, 92vw" quality={88} /></figure>
        <figure class="lift"><Img src="skillender/brochure-lofi-2.jpg" alt="Low-fidelity brochure spread about the SDGs, the Pakistan case study, the solution and why it matters" sizes="(min-width: 1100px) 560px, 92vw" quality={88} /></figure>
      </div>
    </section>

    <!-- STORYBOARD (replaces moodboard and user journey) -->
    <section class="container block" aria-labelledby="story-title">
      <SectionTitle marker="#0B966C" id="story-title">Storyboard</SectionTitle>
      <figure class="drawing" data-reveal><Img src="skillender/storyboard.png" alt="Storyboard of a student: no access to education, dissatisfaction with work, finding SkilLender, learning hands-on skills, making three products and building a livelihood" sizes="(min-width: 1100px) 1080px, 92vw" quality={90} /></figure>
    </section>

    <!-- LOW FIDELITY PROTOTYPE -->
    <section class="container block" aria-labelledby="lofi-title">
      <SectionTitle marker="#0B966C" id="lofi-title">Low Fidelity Prototype</SectionTitle>
      <div class="sketches" data-stagger="0.12">
        <figure class="lift"><Img src="skillender/lofi-sketch-1.jpg" alt="Pencil wireframes of the home, about and get involved pages" sizes="(min-width: 1100px) 640px, 92vw" /></figure>
        <figure class="lift"><Img src="skillender/lofi-sketch-2.jpg" alt="Pencil wireframes of the products page and footer" sizes="(min-width: 1100px) 480px, 92vw" /></figure>
      </div>
      <div class="pages mt" data-sk-pages>
        {[1, 2, 3, 4].map((n) => <figure class="lift"><Img src={`skillender/lofi-page-${n}.jpg`} alt={['Mid-fidelity home page', 'Mid-fidelity workshops page', 'Mid-fidelity products page', 'Mid-fidelity community page'][n - 1]} sizes="(min-width: 1100px) 280px, 46vw" /></figure>)}
      </div>
    </section>

    <!-- USABILITY STUDY -->
    <section class="container block" aria-labelledby="usability-title">
      <SectionTitle marker="#0B966C" id="usability-title">Usability Study</SectionTitle>
      <div data-reveal>
        <p class="copy narrow">We shared the wireframes in critique to see how clearly the workshop schedule came across.</p>
        <h3 class="subhead">Insights</h3>
        <ul class="bullets copy narrow"><li>The overall wireframe worked well.</li><li>Workshops were hard to scan and plan around as a list.</li></ul>
        <h3 class="subhead">Improvements</h3>
        <p class="copy narrow">We added a calendar with a different color for each workshop, so learners can tell sessions apart at a glance and plan ahead. You can see it in the color-coded Meetups on the Community page.</p>
      </div>
    </section>

    <!-- LOGO -->
    <section class="container block" aria-labelledby="logo-title">
      <SectionTitle marker="#0B966C" id="logo-title">Logo</SectionTitle>
      <p class="copy narrow" data-reveal>We explored several marks before landing on a simple, warm symbol that pairs the green of growth with the orange and yellow of handmade craft.</p>
      <div class="logo-lockup" data-sk-logo><Img src="skillender/logo-mark.png" alt="SkilLender logo mark" sizes="96px" quality={90} /><span>SkilLender</span></div>
    </section>

    <!-- COLOR PALETTE -->
    <section class="container block" aria-labelledby="palette-title">
      <SectionTitle marker="#0B966C" id="palette-title">Color Palette</SectionTitle>
      <p class="copy narrow" data-reveal>We chose warm, bright colors that feel hopeful without being childish. #0B966C stands for growth and drives every action, #FF7C4B and #FBBA4E bring the warmth of handmade craft, #313484 anchors the headlines, and #F7F4F1 keeps everything soft and readable.</p>
      <ul class="palette mt" data-stagger="0.07">
        {colors.map((c) => <li style={`background:${c.hex};color:${c.ink}`}><span>{c.hex}</span><small>{c.name}</small></li>)}
      </ul>
    </section>

    <!-- TYPOGRAPHY: no rounded boxes behind -->
    <section class="container block" aria-labelledby="type-title">
      <SectionTitle marker="#0B966C" id="type-title">Typography</SectionTitle>
      <p class="copy narrow" data-reveal>We chose Montserrat Heavy for bold, confident headlines that read clearly from far away, paired with Agrandir Bold for subtitles.</p>
      <div class="specimen mt">
        <div data-reveal><p class="name">Montserrat</p><p class="glyphs">Aa Bb Cc Dd Ee Ff Gg Hh Ii Jj Kk Ll Mm Nn Oo Pp Qq Rr Ss Tt Uu Vv Ww Xx Yy Zz<br />1234567890 .,;’!@#$%^&amp;*</p></div>
        <p class="aa" data-sk-aa aria-hidden="true">Aa1</p>
      </div>
      <div class="typescale" data-stagger="0.1">
        <div><span style="font-weight:900;font-size:clamp(1.7rem,1.2rem + 1.4vw,2.5rem);color:#313484;letter-spacing:-.02em">Master Your Craft</span><span class="label">H1 · Montserrat Heavy · 60</span></div>
        <div><span style="font-weight:700;font-size:clamp(1.15rem,1rem + .5vw,1.55rem);color:#FF7C4B">Connecting Artisans, Educators, and Learners</span><span class="label">Subtitle · Agrandir Bold · 25</span></div>
        <div><span class="small" style="font-size:17px">Join a workshop to gain valuable knowledge from expert artisans.</span><span class="label">Body · Montserrat</span></div>
      </div>
    </section>

    <!-- UI KIT -->
    <section class="container block" aria-labelledby="ui-title">
      <SectionTitle marker="#0B966C" id="ui-title">UI Kit</SectionTitle>
      <figure class="frame" data-reveal="clip"><Img src="skillender/brand-kit.jpg" alt="SkilLender brand and UI kit: logo variations, Montserrat typography, color palette, icons, buttons, progress bar and dropdown" sizes="(min-width: 1100px) 1000px, 92vw" quality={90} /></figure>
    </section>

    <!-- HIGH FIDELITY WEBSITE -->
    <section class="block hifi-section" aria-labelledby="hifi-title">
      <div class="container">
        <SectionTitle marker="#0B966C" id="hifi-title">High Fidelity Website</SectionTitle>
        <p class="copy narrow" data-reveal>Hover over each page to scroll through it.</p>
      </div>
      {hifi.map((h) => (
        <figure class="hifi container">
          <figcaption><span class="hifi-title">{h.title}</span><span class="note">{h.note}</span></figcaption>
          <div class="browser big" data-reveal data-cursor="Scroll">
            <div class="bar"><i></i><i></i><i></i><span>{h.url}</span></div>
            <div class="vp hover" style={`--dur:${h.dur}s`}><Img src={h.src} alt={`SkilLender ${h.title.toLowerCase()}`} sizes="(min-width: 1100px) 1000px, 92vw" quality={88} /></div>
          </div>
        </figure>
      ))}

      <div class="container">
        <div class="devices" data-sk-devices>
          <div class="monitor"><div class="screen"><div class="vp auto" style="--dur:24s;aspect-ratio:16/9.6"><Img src={page.products} alt="Products page on a desktop monitor" sizes="(min-width: 1100px) 560px, 92vw" /></div></div><div class="chin"></div><div class="neck"></div><div class="foot"></div></div>
          <div class="laptop"><div class="lid"><div class="vp auto" style="--dur:22s"><Img src={page.workshops} alt="Workshops page on a laptop" sizes="(min-width: 1100px) 440px, 92vw" /></div></div><div class="base"></div></div>
        </div>
      </div>

      <div class="container">
        <div class="showcase" aria-hidden="true" data-sk-showcase>
          <div class="pattern"></div>
          <div class="tilted">
            {[page.workshops, page.home, page.products, page.community, page.details].map((src) => <div class="tile"><Img src={src} alt="" sizes="180px" /></div>)}
          </div>
        </div>
      </div>

      <div class="container">
        <div class="cascade" aria-hidden="true" data-sk-cascade>
          <div class="browser"><div class="bar"><i></i><i></i><i></i><span>skillender.com</span></div><div class="vp"><Img src={page.home} alt="" sizes="620px" /></div></div>
          <div class="browser"><div class="bar"><i></i><i></i><i></i><span>skillender.com/products</span></div><div class="vp"><Img src={page.products} alt="" sizes="620px" /></div></div>
          <div class="browser"><div class="bar"><i></i><i></i><i></i><span>skillender.com/products/cutting-board</span></div><div class="vp"><Img src={page.details} alt="" sizes="620px" /></div></div>
        </div>
      </div>
    </section>

    <!-- BROCHURE: just the attached image -->
    <section class="container block" aria-labelledby="brochure-title">
      <SectionTitle marker="#0B966C" id="brochure-title">Brochure</SectionTitle>
      <p class="copy narrow" data-reveal>A tri-fold brochure brings SkilLender offline, where many learners can’t access the internet. It explains the SDGs, the Pakistan case study, and how students, instructors, stores and donors fit together.</p>
      <figure class="frame mt brochure" data-reveal="clip"><Img src="skillender/brochure-stack.png" alt="Printed SkilLender tri-fold brochure, open and closed, on a light surface" sizes="(min-width: 1100px) 1000px, 92vw" quality={90} /></figure>
    </section>

    <!-- PROMOTIONAL VIDEO: full width, edge to edge -->
    <section class="block promo" aria-labelledby="promo-title">
      <div class="container">
        <SectionTitle marker="#0B966C" id="promo-title">Promotional Video</SectionTitle>
        <p class="copy narrow" data-reveal>A short film tells the story, from the barriers learners face to the website and brochure in use. <a class="text-link" href="https://youtu.be/XUvpPGkoSJY" target="_blank" rel="noopener">Watch on YouTube</a></p>
      </div>
      <div class="video-bleed mt" data-sk-video>
        <video controls playsinline preload="metadata" poster="/video/skillender-promo-poster.jpg" aria-label="SkilLender promotional video">
          <source src="/video/skillender-promo-1080.mp4" type="video/mp4" />
        </video>
      </div>
    </section>

    <!-- IMPACT -->
    <section class="container block" aria-labelledby="impact-title">
      <SectionTitle marker="#0B966C" id="impact-title">Impact</SectionTitle>
      <ul class="cards" data-stagger="0.1">
        <li data-tilt><span class="num">01</span><h3 class="serif">Deployment</h3><p class="small">The website, brochure and app are the starting point, connecting vendors, students, craftsmen and businesses in one place.</p></li>
        <li data-tilt><span class="num">02</span><h3 class="serif">Inclusion</h3><p class="small">Digital and physical formats reach everyone, and local leadership keeps the program rooted in local culture.</p></li>
        <li data-tilt><span class="num">03</span><h3 class="serif">Resources</h3><p class="small">Local businesses and skilled community members teach. Products cover costs, so nothing goes to waste.</p></li>
      </ul>
    </section>

    <!-- REFLECTION -->
    <section class="container block" aria-labelledby="reflection-title">
      <SectionTitle marker="#0B966C" id="reflection-title">Final Reflection</SectionTitle>
      <div class="copy narrow" data-reveal>
        <p>SkilLender started as a brochure and grew into a full system with a brand, a website and a film. Designing for people with limited internet access and literacy taught me to lean on clear imagery, simple language and offline touchpoints.</p>
        <p style="margin-top:18px">Working as a team of three, I learned how much stronger an idea gets when it’s challenged early, and that the best solutions for social problems are ones that can sustain themselves.</p>
      </div>
    </section>

    <footer class="signature container">
      <div class="brandline" data-sk-logo><Img src="skillender/logo-mark.png" alt="" sizes="56px" />SkilLender</div>
    </footer>
  </div>
  <NextProject current="skillender" />
</Base>

<style>
  :global(html[data-page='skillender'] body) {
    --page-bg: #f7f4f1; --page-fg: #23263b; --body-fg: rgba(35,38,59,.8); --ink: #23263b; --ink-2: rgba(35,38,59,.8); --ink-3: rgba(35,38,59,.56);
    --line: rgba(35,38,59,.1); --paper: #f7f4f1; --paper-2: #f7f4f1; background: #f7f4f1;
  }
  .sk { position: relative; overflow: clip; color: #23263b; --green: #0b966c; --orange: #ff7c4b; --indigo: #313484; --line: rgba(35,38,59,.1); }
  .block { padding-block: clamp(48px, 6vw, 72px); }
  .mt { margin-top: clamp(28px, 3.4vw, 44px); }
  .gap { margin-top: clamp(40px, 5vw, 64px); }
  .narrow { max-width: 812px; }
  .copy { color: rgba(35,38,59,.8); }
  .copy strong { color: #23263b; }
  .small { font-size: var(--fs-small); line-height: 1.6; color: rgba(35,38,59,.8); }
  .serif { font-family: var(--font-accent); font-style: normal; font-weight: 400; font-size: clamp(1.6rem, 1.2rem + 1vw, 2.05rem); letter-spacing: -.01em; line-height: 1.25; margin: 12px 0 8px; }
  .subhead { font-weight: 300; font-size: clamp(1.6rem, 1.3rem + .9vw, 2.05rem); letter-spacing: -.02em; line-height: 1.2; margin: clamp(28px, 3vw, 40px) 0 14px; }
  figure { margin: 0; }
  .label { color: rgba(35,38,59,.56); }
  .text-link { color: var(--green); font-weight: 600; background: linear-gradient(currentColor, currentColor) 0 100% / 100% 1.5px no-repeat; transition: background-size .5s var(--ease-out); }
