---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import SectionTitle from '../components/SectionTitle.astro';
import MetaStrip from '../components/case/MetaStrip.astro';
import NextProject from '../components/case/NextProject.astro';
import { projects } from '../data/projects';
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';

const project = projects.find((p) => p.slug === 'gosafe')!;
const s = (name: string) => `gosafe/screens/${name}.webp`;

// High fidelity rows, in the order and grouping of the reference page.
const screenGroups = [
  { title: 'Splash and Onboarding Screens', note: 'An emergency contact is added during sign-up, so safety is ready from day one.', rows: [[['splash', 'Splash'], ['signup', 'Create account'], ['login', 'Log in']]] },
  { title: 'Home Screen and Menu', note: '“Where to tonight?” Recent places, weather and every tool one tap away.', rows: [[['home', 'Home'], ['account', 'Account menu']]] },
  { title: 'Journey Screens', note: 'Search a destination, see the route, then choose bus, SafeRide or walk.', sm: true, rows: [[['plan', 'Plan your trip'], ['search', 'Search places'], ['choosemap', 'Choose on map'], ['travel', 'Choose way of travel']]] },
  { title: 'Emergency Contact Screens', note: 'Add, edit and choose who can follow your live trip.', sm: true, rows: [[['contact-add', 'Add contact'], ['contact-edit', 'Edit contact'], ['contacts', 'Contacts list'], ['safety-setup', 'Safety setup']]] },
  { title: 'Safety Screens', note: 'The main nudge. A long stop triggers a check-in: confirm you’re safe, message your contact, or call 911.', sm: true, rows: [[['live', 'Live journey'], ['are-you-safe', 'Are you safe'], ['help', 'How can we help'], ['call-mom', 'Calling Mom']], [['message-mom', 'Message Mom'], ['sent', 'Message sent'], ['call-911', 'Calling 911']]] },
  { title: 'End of Journey and Review Screens', note: 'Every trip ends on a good note, with a quick rating to improve the next one.', rows: [[['end-journey', 'End your journey'], ['made-it', 'You made it']]] },
  { title: 'Settings Screens', note: 'Navigation preferences, saved places, profile and notifications.', sm: true, rows: [[['settings', 'Settings'], ['navigation', 'Navigation'], ['location', 'Location'], ['bookmarks', 'Location bookmarks']], [['bookmark-add', 'Add bookmark'], ['profile', 'Profile'], ['notifications', 'Notifications']]] },
];

const mainColors = [
  { hex: '#0B1220', name: 'Night' },
  { hex: '#151F32', name: 'Surface' },
  { hex: '#3B82F6', name: 'Action' },
  { hex: '#3BA776', name: 'Safe' },
];
const subColors = [
  { hex: '#60A5FA', ink: '#0B1220' },
  { hex: '#F8FAFC', ink: '#0B1220' },
  { hex: '#94A3B8', ink: '#0B1220' },
  { hex: '#F59E0B', ink: '#0B1220' },
  { hex: '#EF4444', ink: '#fff' },
];
---

<Base
  page="gosafe"
  title="GoSafe"
  description="GoSafe is a nighttime safety and transportation app that helps Iowa State students plan their way home and feel confident on the journey."
  theme="dark"
  accent={project.accent}
  progress
  navOnDark
  hideFooter
  ogImage="home/gosafe.png"
>
  <div class="gs">
    <span class="aurora" aria-hidden="true"></span>

    <!-- HERO -->
    <header class="intro container-wide" aria-labelledby="case-title">
      <p class="label crumbs"><a class="link-draw" href="/work">Work</a><span aria-hidden="true">/</span><span>UX Design</span></p>
      <div class="intro-copy">
        <h1 id="case-title" class="title" data-split="intro">GoSafe</h1>
        <p class="lead description" data-reveal><strong>GoSafe</strong> is a nighttime safety and transportation app that helps Iowa State students plan their way home and feel confident on the journey, especially when they travel alone or don’t have a car.</p>
      </div>
    </header>
    <MetaStrip project={project} />

    <figure class="hero-render container">
      <span class="hero-glow" aria-hidden="true"></span>
      <div class="hero-tilt" data-tilt="5"><div class="hero-frame" data-gs-hero>
        <div><Img src="gosafe/mockup-hero.jpg" alt="GoSafe logo with three phones showing trip planning, the home screen and a safety check-in" sizes="(min-width: 960px) 820px, 92vw" quality={92} eager /></div>
      </div></div>
    </figure>

    <!-- PROBLEM / SOLUTION -->
    <section class="container block problem" aria-label="Problem and solution">
      <div>
        <div data-reveal>
          <SectionTitle marker="#3ba776" id="problem">Problem</SectionTitle>
          <p class="copy">Students who travel around campus late at night often feel unsafe. Fewer buses, long SafeRide waits and dark walks make getting home stressful, and transportation info is scattered across different apps.</p>
        </div>
        <div class="gap" data-reveal>
          <SectionTitle marker="#3ba776" id="solution">Solution</SectionTitle>
          <p class="copy">GoSafe brings every travel option into one place, plans the best route, and quietly checks in when something seems off. With one tap, students can tell their emergency contact they’re safe or ask for help.</p>
        </div>
      </div>
      <div class="tilt" aria-hidden="true">
        <span class="tilt-halo"></span>
        <div class="tilt-phone" data-gs-tilt><Img src={s('are-you-safe')} alt="" sizes="260px" /></div>
      </div>
    </section>

    <!-- USER RESEARCH -->
    <section class="container block" aria-labelledby="research-title">
      <SectionTitle marker="#3ba776" id="research-title">User Research</SectionTitle>
      <p class="copy narrow" data-reveal>I interviewed three Iowa State students about how they get around campus at night, how they choose between buses, SafeRide, cars and friends, and the moments they felt safe or unsafe.</p>
      <ul class="cards mt" data-stagger="0.1">
        <li class="card" data-tilt>
          <span class="tag" style="background:#3BA776"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z"></path></svg></span>
          <h3 class="serif">Safety over speed</h3><p class="small">Students would rather wait longer or change plans than walk alone.</p>
        </li>
        <li class="card" data-tilt>
          <span class="tag" style="background:#3B82F6"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="3"></rect><path d="M3 9h18M8 2v4M16 2v4"></path></svg></span>
          <h3 class="serif">Planning is scattered</h3><p class="small">They jump between MyState, Apple Maps and SafeRide to piece together a trip.</p>
        </li>
        <li class="card" data-tilt>
          <span class="tag" style="background:#F59E0B"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg></span>
          <h3 class="serif">Waiting adds stress</h3><p class="small">Long waits at night raise anxiety, especially when alone.</p>
        </li>
      </ul>
      <div class="quotes" data-stagger="0.12">
        <blockquote class="quote"><p>“I’m usually pretty scared to walk around campus at night.”</p></blockquote>
        <blockquote class="quote"><p>“I felt unsafe walking home, so I called my brother.”</p></blockquote>
        <blockquote class="quote"><p>“At night you have to know which buses specifically run.”</p></blockquote>
      </div>
    </section>

    <!-- JOURNEY MAP -->
    <section class="container block" aria-labelledby="journey-title">
      <SectionTitle marker="#3ba776" id="journey-title">Journey Map</SectionTitle>
      <p class="copy narrow" data-reveal>Mapping the trip home showed the lowest point clearly: the <strong>Action</strong> stage, when a student is waiting or walking alone at night.</p>
      <figure class="plain mt" data-reveal="clip"><Img src="gosafe/journey-map.jpg" alt="Journey map of a student’s nighttime trip home, from deciding to leave to arriving" sizes="(min-width: 1240px) 1180px, 92vw" quality={88} /></figure>
    </section>

    <!-- KEY INSIGHT -->
    <section class="container block" aria-labelledby="insight-title">
      <SectionTitle marker="#3ba776" id="insight-title">Key Insight</SectionTitle>
      <p class="copy narrow" data-reveal>Students are willing to wait longer, change their plans, or call friends and family just to avoid walking alone at night, because <strong>feeling safe matters more than getting there quickly.</strong></p>
      <div class="hmw mt" data-reveal data-tilt>
        <span class="hmw-sheen" aria-hidden="true"></span>
        <p class="label">How might we</p>
        <p class="hmw-q" data-words>How might we help ISU students plan nighttime transportation without the frustration, and feel less uncomfortable during the journey?</p>
      </div>
    </section>

    <!-- DESIGN OPPORTUNITIES -->
    <section class="container block" aria-labelledby="opps-title">
      <SectionTitle marker="#3ba776" id="opps-title">Design Opportunities</SectionTitle>
      <p class="copy narrow" data-reveal>Using the Fogg Behavior Model, I turned three moments of the journey into nudges that make the safe choice the easy one.</p>
      <ul class="cards mt" data-stagger="0.1">
        <li class="card" data-tilt><span class="label" style="color:#60A5FA">Intention → Decision</span><h3 class="serif">Feeling overwhelmed</h3><p class="small">One place to see every option, with the best journey planned for you.</p></li>
        <li class="card" data-tilt><span class="label" style="color:#FCA5A5">Action</span><h3 class="serif">Feeling unsafe</h3><p class="small">A gentle “Are you safe?” check-in when the app notices a long stop.</p></li>
        <li class="card" data-tilt><span class="label" style="color:#FCD34D">Post-Action</span><h3 class="serif">No voice after</h3><p class="small">Rate &amp; review each trip so the next one can be better.</p></li>
      </ul>
    </section>

    <!-- LOW FIDELITY -->
    <section class="container block" aria-labelledby="lofi-title">
      <SectionTitle marker="#3ba776" id="lofi-title">Low Fidelity Prototype</SectionTitle>
      <p class="copy narrow" data-reveal>I started on paper, tested the sketches, and combined the strongest ideas: the emergency contact and safety check became one screen, and the best home layouts merged into one.</p>
      <div class="lofi-row mt" data-stagger="0.12">
        <figure class="zoom"><Img src="gosafe/paper-sketches.jpg" alt="Early paper sketches of the GoSafe screens" sizes="(min-width: 900px) 30vw, 92vw" /></figure>
        <figure class="zoom"><Img src="gosafe/paper-final.jpg" alt="Final paper prototype screens drawn in phone frames" sizes="(min-width: 900px) 30vw, 92vw" /></figure>
        <figure class="zoom"><Img src="gosafe/lofi-figma.jpg" alt="Low-fidelity wireframes and prototype flow in Figma" sizes="(min-width: 900px) 30vw, 92vw" /></figure>
      </div>
    </section>

    <!-- USABILITY STUDY (low fidelity) -->
    <section class="container block" aria-labelledby="usability-1-title">
      <SectionTitle marker="#3ba776" id="usability-1-title">Usability Study</SectionTitle>
      <div class="study">
        <div class="study-copy" data-reveal>
          <p class="copy">I tested the low-fidelity prototype with students on their phones to evaluate navigation and ease of use.</p>
          <h3 class="subhead">Insights</h3>
          <ul class="bullets copy">
            <li>The hamburger menu and back navigation were confusing.</li>
            <li>Some text, titles and buttons were hidden or didn’t work.</li>
            <li>Users wanted their emergency contacts visible right away.</li>
          </ul>
        </div>
        <figure class="study-photos" data-reveal="clip"><Img src="gosafe/testing-photos.jpg" alt="Four photos of students testing the paper prototype on their phones" sizes="(min-width: 900px) 34vw, 92vw" /></figure>
        <div class="study-more" data-reveal>
          <h3 class="subhead">Improvements</h3>
          <p class="copy">I fixed navigation and button functionality, improved text visibility, put the most recent contact on top, and added a quick-call 911 option.</p>
        </div>
      </div>
    </section>

    <!-- USER FLOW -->
    <section class="container block" aria-labelledby="flow-title">
      <SectionTitle marker="#3ba776" id="flow-title">User Flow</SectionTitle>
      <figure class="plain" data-reveal="clip"><Img src="gosafe/userflow.jpg" alt="Final GoSafe user flow from sign-up to arriving home safely" sizes="(min-width: 1240px) 1180px, 92vw" quality={88} /></figure>
    </section>

    <!-- LOGO -->
    <section class="container block" aria-labelledby="logo-title">
      <SectionTitle marker="#3ba776" id="logo-title">Logo</SectionTitle>
      <div class="logo-stage" data-reveal><div class="logo-mark" data-gs-logo><Img src="gosafe/logo.png" alt="GoSafe logo: a green G with an arrow leading into the word Safe" sizes="460px" quality={90} /></div></div>
    </section>

    <!-- COLOR PALETTE -->
    <section class="container block" aria-labelledby="palette-title">
      <SectionTitle marker="#3ba776" id="palette-title">Color Palette</SectionTitle>
      <p class="copy narrow" data-reveal>I chose a dark, calm palette that’s easy on the eyes at night. #0B1220 and #151F32 set a quiet base, #3B82F6 guides every action, #3BA776 confirms you’re safe, and #EF4444 is saved for moments that need help.</p>
      <ul class="palette mt" data-stagger="0.07">
        {mainColors.map((c) => <li style={`background:${c.hex}`}><span>{c.hex}</span><small>{c.name}</small></li>)}
      </ul>
      <ul class="palette sub" data-stagger="0.06">
        {subColors.map((c) => <li style={`background:${c.hex};color:${c.ink}`}><span>{c.hex}</span></li>)}
      </ul>
    </section>

    <!-- TYPOGRAPHY -->
    <section class="container block" aria-labelledby="type-title">
      <SectionTitle marker="#3ba776" id="type-title">Typography</SectionTitle>
      <p class="copy narrow" data-reveal>I chose Inter for its clear, highly legible shapes, so students can read the screen at a glance, even while walking in the dark.</p>
      <div class="specimen mt">
        <div data-reveal><p class="name">Inter</p><p class="glyphs">Aa Bb Cc Dd Ee Ff Gg Hh Ii Jj Kk Ll Mm Nn Oo Pp Qq Rr Ss Tt Uu Vv Ww Xx Yy Zz<br />1234567890 .,;’!@#$%^&amp;*</p></div>
        <p class="aa" data-gs-aa aria-hidden="true">Aa1</p>
      </div>
    </section>

    <!-- LAWS OF UX -->
    <section class="container block" aria-labelledby="laws-title">
      <SectionTitle marker="#3ba776" id="laws-title">Laws of UX</SectionTitle>
      <ul class="cards" data-stagger="0.1">
        <li class="card" data-tilt><h3 class="serif">Hick’s Law</h3><b class="law">Choose a way to travel</b><p class="small">Travel options appear as simple cards, so comparing them is quick.</p></li>
        <li class="card" data-tilt><h3 class="serif">Fitts’s Law</h3><b class="law">Are you safe?</b><p class="small">Large “I’m Safe” and “I Need Help” buttons for stressful moments.</p></li>
        <li class="card" data-tilt><h3 class="serif">Tesler’s Law</h3><b class="law">Safety setup</b><p class="small">Pick a saved emergency contact instead of typing it every time.</p></li>
      </ul>
    </section>

    <!-- HIGH FIDELITY -->
    <section class="block hifi-section" aria-labelledby="hifi-title">
      <div class="container"><SectionTitle marker="#3ba776" id="hifi-title">High Fidelity Prototype</SectionTitle></div>
      {screenGroups.map((g) => (
        <figure class="hifi container">
          <figcaption><span class="hifi-title">{g.title}</span><span class="note">{g.note}</span></figcaption>
          {g.rows.map((row) => (
            <div class:list={['row', { sm: g.sm }]} data-gs-row>
              {row.map(([file, label]) => <div class="phone"><Img src={s(file)} alt={`GoSafe ${label.toLowerCase()} screen`} sizes="(min-width: 900px) 216px, 34vw" quality={90} /></div>)}
            </div>
          ))}
        </figure>
      ))}
      <div class="container">
        <figure class="showcase" data-gs-showcase>
          <div class="showcase-media"><Img src="gosafe/mockup-showcase.jpg" alt="Every GoSafe screen laid out in a tilted grid of phones" sizes="(min-width: 1240px) 1180px, 100vw" quality={90} /></div>
        </figure>
      </div>
    </section>

    <!-- USABILITY STUDY (high fidelity) + REFLECTION, render on the right -->
    <section class="container block closing" aria-label="Usability study and final reflection">
      <div class="closing-copy">
        <div data-reveal>
          <SectionTitle marker="#3ba776" id="usability-2-title">Usability Study</SectionTitle>
          <p class="copy">I tested the high-fidelity prototype with three users to see how easy it was to plan a trip, use the safety features, and manage contacts.</p>
          <h3 class="subhead">Insights</h3>
          <ul class="bullets copy">
            <li>The Safety Check needed to be more visible, with a way to turn it on or off.</li>
            <li>Users wanted an “End Journey” option and an easier-to-tap back arrow.</li>
            <li>Saved places needed clearer Home and Work shortcuts and distinct icons.</li>
            <li>Users wanted to view and edit emergency contacts and their profile.</li>
          </ul>
          <h3 class="subhead">Improvements</h3>
          <p class="copy">I simplified navigation, made safety features one tap away, added End Journey and a safety-check toggle, and gave contacts and profile their own editable screens.</p>
        </div>
        <div class="gap" data-reveal>
          <SectionTitle marker="#3ba776" id="reflection-title">Final Reflection</SectionTitle>
          <p class="copy">Designing GoSafe taught me that the best solution isn’t always the fastest one. Students cared more about feeling safe than getting home quickly, so I designed for that feeling first.</p>
          <p class="copy" style="margin-top:18px">Testing at every stage, from paper to high fidelity, showed me how small changes like bigger buttons, clearer navigation and fewer choices matter most in stressful moments.</p>
        </div>
      </div>
      <div class="duo" aria-hidden="true" data-gs-duo>
        <span class="duo-glow"></span>
        <div class="duo-back"><Img src={s('safety-setup')} alt="" sizes="300px" quality={90} /></div>
        <div class="duo-front"><Img src={s('live')} alt="" sizes="300px" quality={90} /></div>
      </div>
    </section>

    <footer class="signature container">
      <Img src="gosafe/logo.png" alt="GoSafe" sizes="200px" />
      <p class="label">Khadija Sardar <span>·</span> UX Design <span>·</span> Fall 2026</p>
    </footer>
  </div>
  <NextProject current="gosafe" />
</Base>

<style>
  :global(html[data-page='gosafe']) { color-scheme: dark; background: #0b1220; }
  :global(html[data-page='gosafe'] body) {
    --page-bg: #0b1220; --page-fg: #fff; --body-fg: rgba(255,255,255,.82); --ink-3: rgba(255,255,255,.6);
    --line: rgba(148,163,184,.14); --paper: #0b1220; --paper-2: #0b1220; --charcoal: #0b1220;
    background: #0b1220; color: #fff;
  }
  /* One background throughout: no lighter bands anywhere on the page. */
  .gs { position: relative; overflow: clip; background: #0b1220; color: #fff; --card: #151f32; --sky: #60a5fa; --green: #3ba776; }
  .aurora { position: absolute; inset: -200px 0 auto; height: 1300px; pointer-events: none; background: radial-gradient(700px 420px at 72% 55%, rgba(59,130,246,.18), transparent 70%), radial-gradient(520px 360px at 18% 70%, rgba(59,167,118,.12), transparent 70%); animation: drift 18s ease-in-out infinite alternate; }
  @keyframes drift { to { transform: translate3d(0, 60px, 0) scale(1.05); } }

  .block { padding-block: clamp(48px, 6vw, 72px); }
  .mt { margin-top: clamp(28px, 3.4vw, 44px); }
  .gap { margin-top: clamp(40px, 5vw, 64px); }
  .narrow { max-width: 812px; }
  .copy { color: rgba(255,255,255,.82); }
  .small { font-size: var(--fs-small); line-height: 1.6; color: rgba(255,255,255,.82); }
  .serif { font-family: var(--font-accent); font-style: normal; font-weight: 400; font-size: clamp(1.6rem, 1.2rem + 1vw, 2.05rem); letter-spacing: -.01em; line-height: 1.25; margin: 14px 0 8px; color: #fff; }
  .subhead { font-weight: 300; font-size: clamp(1.6rem, 1.3rem + .9vw, 2.05rem); letter-spacing: -.02em; line-height: 1.2; margin: clamp(28px, 3vw, 40px) 0 14px; }
  figure { margin: 0; }
  .label { color: rgba(255,255,255,.6); }

  /* hero */
  .intro { position: relative; padding-top: clamp(132px, 17vh, 200px); }
  .crumbs { display: flex; gap: 10px; }
  .intro-copy { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: end; gap: clamp(28px, 5vw, 72px); padding-block: clamp(28px, 4vw, 56px) 8px; }
  .title { font-weight: 300; font-size: clamp(4rem, 10.2vw, 9.5rem); letter-spacing: -.055em; line-height: .95; white-space: nowrap; padding-right: .08em; }
  .description { max-width: 34ch; color: rgba(255,255,255,.82); }
  .description strong { color: #fff; font-weight: 600; }
  .hero-render { position: relative; display: grid; place-items: center; margin-top: clamp(36px, 5vw, 64px); perspective: 1400px; }
  .hero-glow { position: absolute; inset: 10% 15%; border-radius: 50%; background: radial-gradient(closest-side, rgba(59,130,246,.35), transparent); filter: blur(30px); animation: pulse 6s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: .55; transform: scale(1.08); } }
  .hero-tilt { width: min(100%, 820px); }
  .hero-frame { position: relative; width: min(100%, 820px); border-radius: 26px; overflow: hidden; box-shadow: 0 50px 120px -40px rgba(0,0,0,.8), 0 0 0 1px rgba(148,163,184,.12); will-change: transform; }
  .hero-frame :global(img) { display: block; width: 100%; height: auto; }

  /* problem */
  .problem { display: grid; grid-template-columns: 1fr minmax(260px, 400px); gap: clamp(40px, 6vw, 64px); align-items: center; }
  .tilt { position: relative; display: grid; place-items: center; min-height: 520px; perspective: 1600px; }
  .tilt-halo { position: absolute; width: 85%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(closest-side, rgba(59,167,118,.35), transparent); animation: pulse 5s ease-in-out infinite; }
  .tilt-phone { position: relative; width: 250px; transform: rotateY(-22deg) rotateX(6deg) rotateZ(6deg); filter: drop-shadow(-30px 40px 50px rgba(0,0,0,.6)); }
  .tilt-phone :global(img) { width: 100%; }

  /* cards */
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; list-style: none; }
  .card { position: relative; background: var(--card); border: 1px solid var(--line); border-radius: 22px; padding: 30px 28px; transition: border-color .5s var(--ease-out), box-shadow .5s var(--ease-out); transform-style: preserve-3d; }
  .card:hover { border-color: rgba(96,165,250,.45); box-shadow: 0 30px 60px -30px rgba(59,130,246,.45); }
  .tag { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; }
  .tag svg { width: 20px; height: 20px; stroke: #fff; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .card:hover .tag { animation: bob .8s var(--ease-out); }
  @keyframes bob { 40% { transform: translateY(-6px) rotate(-6deg); } }
  .law { display: block; font-family: var(--font-mono); font-size: var(--fs-label); font-weight: 500; letter-spacing: .08em; text-transform: uppercase; color: var(--sky); margin: 4px 0 12px; }
  .quotes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 20px; }
  .quote { margin: 0; border-left: 2px solid var(--green); padding: 6px 0 6px 18px; }
  .quote p { font-family: var(--font-accent); font-style: italic; font-size: var(--fs-body); line-height: 1.45; color: #fff; }

  .plain { border-radius: 18px; overflow: hidden; }
  .plain :global(img) { display: block; width: 100%; height: auto; }

  .hmw { position: relative; overflow: hidden; border-radius: 24px; padding: clamp(28px, 4vw, 44px); background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%); }
  .hmw .label { color: rgba(255,255,255,.75); margin-bottom: 14px; }
  .hmw-q { position: relative; font-weight: 300; font-size: clamp(1.6rem, 1.1rem + 1.6vw, 2.25rem); letter-spacing: -.02em; line-height: 1.3; }
  .hmw-sheen { position: absolute; inset: 0; background: linear-gradient(110deg, transparent 30%, rgba(255,255,255,.16) 50%, transparent 70%); transform: translateX(-100%); animation: sheen 6s var(--ease-inout) infinite; }
  @keyframes sheen { 0% { transform: translateX(-100%); } 55%, 100% { transform: translateX(100%); } }

