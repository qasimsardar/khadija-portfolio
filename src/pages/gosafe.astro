---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import SectionTitle from '../components/SectionTitle.astro';
import MetaStrip from '../components/case/MetaStrip.astro';
import NextProject from '../components/case/NextProject.astro';
import { projects } from '../data/projects';

const project = projects.find((p) => p.slug === 'gosafe')!;
const screens = [
  { title: 'Plan a trip', src: 'gosafe/screens/plan.webp' },
  { title: 'Choose a route', src: 'gosafe/screens/choosemap.webp' },
  { title: 'Live journey', src: 'gosafe/screens/live.webp' },
  { title: 'Safety check-in', src: 'gosafe/screens/are-you-safe.webp' },
  { title: 'Get help', src: 'gosafe/screens/help.webp' },
  { title: 'Journey complete', src: 'gosafe/screens/made-it.webp' },
];
const colors = [
  { name: 'Night', value: '#0B1220' }, { name: 'Surface', value: '#151F32' },
  { name: 'Action', value: '#3B82F6' }, { name: 'Safe', value: '#3BA776' },
  { name: 'Sky', value: '#60A5FA' }, { name: 'Alert', value: '#F59E0B' },
  { name: 'Help', value: '#EF4444' },
];
---

<Base
  page="gosafe"
  title="GoSafe"
  description="GoSafe is a nighttime safety and transportation app that helps Iowa State students plan their way home and feel confident on the journey."
  theme="dark"
  accent={project.accent}
  progress
  navOnDark
  hideFooter
  ogImage="home/gosafe.jpg"
>
  <div class="gosafe-page">
    <header class="intro container-wide" aria-labelledby="case-title">
      <p class="label crumbs"><a class="link-draw" href="/work">Work</a><span aria-hidden="true">/</span><span>UX Design</span></p>
      <div class="intro-copy">
        <h1 id="case-title" class="display title" data-split="intro">GoSafe</h1>
        <p class="lead description" data-reveal><strong>GoSafe</strong> is a nighttime safety and transportation app that helps Iowa State students plan their way home and feel confident on the journey, especially when they travel alone or don’t have a car.</p>
      </div>
      <MetaStrip project={project} />
    </header>

    <figure class="hero-art container-wide" data-reveal="clip">
      <Img src="gosafe/screens-overview.png" alt="GoSafe app screens for trip planning, the home screen and a safety check-in" sizes="(min-width: 1440px) 1312px, 92vw" eager />
      <figcaption class="label">PLAN AHEAD. GET HOME SAFELY.</figcaption>
    </figure>

    <section class="story container" aria-label="Problem and solution">
      <article data-reveal>
        <SectionTitle marker="#3ba776" id="problem">Problem</SectionTitle>
        <p class="copy">Students who travel around campus late at night often feel unsafe. Fewer buses, long SafeRide waits and dark walks make getting home stressful, and transportation information is scattered across different apps.</p>
      </article>
      <article data-reveal>
        <SectionTitle marker="#3b82f6" id="solution">Solution</SectionTitle>
        <p class="copy">GoSafe brings every travel option into one place, plans the best route, and quietly checks in when something seems off. With one tap, students can tell their emergency contact they’re safe or ask for help.</p>
      </article>
    </section>

    <section class="research container-wide" aria-labelledby="research-title">
      <SectionTitle marker="#3ba776" id="research-title">User Research</SectionTitle>
      <div class="research-intro">
        <p class="copy">I interviewed three Iowa State students about how they get around campus at night, when they choose buses, SafeRide, cars or friends, and what makes a trip feel safe or unsafe.</p>
        <blockquote class="quote" data-reveal><p>“I’m usually pretty scared to walk around campus at night.”</p><cite class="label">ISU STUDENT</cite></blockquote>
      </div>
      <div class="insights" data-stagger="0.08">
        <article data-reveal><span class="label">01 / SAFETY OVER SPEED</span><h3>Feeling safe comes first.</h3><p class="copy">Students would rather wait longer or change plans than walk alone.</p></article>
        <article data-reveal><span class="label">02 / PLANNING IS SCATTERED</span><h3>One trip, many apps.</h3><p class="copy">They jump between MyState, Apple Maps and SafeRide to piece together a trip.</p></article>
        <article data-reveal><span class="label">03 / WAITING ADDS STRESS</span><h3>Long waits feel longer at night.</h3><p class="copy">Waiting alone raises anxiety, especially when plans are uncertain.</p></article>
      </div>
    </section>

    <section class="persona container-wide" aria-labelledby="persona-title">
      <div class="persona-copy"><SectionTitle marker="#60a5fa" id="persona-title">Meet Maya</SectionTitle><p class="copy">Maya is a 20-year-old full-time student with evening classes. She uses SafeRide and wants to get home before midnight, avoiding dark or quiet areas whenever she can.</p><p class="copy">Her story helped keep the design grounded in the real decisions students make when traveling at night.</p></div>
      <figure class="research-image" data-reveal="clip"><Img src="gosafe/persona.jpg" alt="GoSafe user persona for Maya, a student who wants a safe trip home at night" sizes="(min-width: 900px) 48vw, 92vw" /></figure>
    </section>

    <section class="maps container-wide" aria-label="Research maps">
      <figure class="research-image" data-reveal="clip"><Img src="gosafe/empathy-map.jpg" alt="GoSafe empathy map capturing what a student thinks, feels, says and does" sizes="(min-width: 900px) 44vw, 92vw" /><figcaption class="label">EMPATHY MAP</figcaption></figure>
      <figure class="research-image" data-reveal="clip"><Img src="gosafe/journey-map.jpg" alt="GoSafe student journey map for getting home at night" sizes="(min-width: 900px) 44vw, 92vw" /><figcaption class="label">JOURNEY MAP</figcaption></figure>
    </section>

    <section class="insight-band" data-reveal>
      <div class="container-wide"><span class="label">KEY INSIGHT</span><p class="display">Students are willing to wait longer, change plans or call someone they trust just to avoid walking alone. Feeling safe matters more than getting there quickly.</p><p class="copy hmw"><strong>How might we</strong> help ISU students plan nighttime transportation without the frustration, and feel less uncomfortable during the journey?</p></div>
    </section>

    <section class="design container-wide" aria-labelledby="design-title">
      <SectionTitle marker="#3b82f6" id="design-title">Designing for safer journeys</SectionTitle>
      <p class="copy design-lead">Behavior design helped turn the research into small, timely moments of support throughout a trip.</p>
      <div class="design-cards" data-stagger="0.08">
        <article data-reveal><span class="label">01 / DECISION</span><h3>Make choices easier.</h3><p class="copy">See every travel option in one place, with a recommended journey ready to go.</p></article>
        <article data-reveal><span class="label">02 / ACTION</span><h3>Check in at the right moment.</h3><p class="copy">A gentle “Are you safe?” prompt appears when the app notices a long stop.</p></article>
        <article data-reveal><span class="label">03 / AFTER</span><h3>Make the next trip better.</h3><p class="copy">Rate and review each journey to help improve future recommendations.</p></article>
      </div>
    </section>

    <section class="process container-wide" aria-labelledby="process-title">
      <SectionTitle marker="#f59e0b" id="process-title">From sketches to a tested flow</SectionTitle>
      <p class="copy process-lead">I started with paper sketches, tested the layouts, then combined the clearest ideas into a low-fidelity prototype. Testing showed that navigation, visible emergency contacts and working buttons mattered most.</p>
      <div class="process-grid">
        <figure class="research-image wide" data-reveal="clip"><Img src="gosafe/paper-sketches.jpg" alt="Early paper sketches exploring GoSafe app screens" sizes="(min-width: 900px) 88vw, 92vw" /><figcaption class="label">EARLY PAPER SKETCHES</figcaption></figure>
        <figure class="research-image" data-reveal="clip"><Img src="gosafe/testing-combine.jpg" alt="GoSafe paper prototype layouts combined after student feedback" sizes="(min-width: 900px) 44vw, 92vw" /><figcaption class="label">TEST, COMBINE, REFINE</figcaption></figure>
        <figure class="research-image" data-reveal="clip"><Img src="gosafe/lofi-figma.jpg" alt="GoSafe low fidelity prototype in Figma" sizes="(min-width: 900px) 44vw, 92vw" /><figcaption class="label">LOW-FIDELITY PROTOTYPE</figcaption></figure>
      </div>
    </section>

    <section class="flow container-wide" aria-labelledby="flow-title">
      <SectionTitle marker="#60a5fa" id="flow-title">The user flow</SectionTitle>
      <figure class="research-image" data-reveal="clip"><Img src="gosafe/userflow.jpg" alt="GoSafe user flow from choosing a destination to finishing a safe trip" sizes="92vw" /><figcaption class="label">A CLEAR PATH FROM PLAN TO ARRIVAL</figcaption></figure>
    </section>

    <section class="brand container-wide" aria-labelledby="brand-title">
      <div class="brand-copy"><SectionTitle marker="#3ba776" id="brand-title">A calm visual language</SectionTitle><p class="copy">I chose a dark, calm palette that’s easy on the eyes at night. Deep navy sets a quiet base, blue guides each action, green confirms safety, and red is saved for moments that need help.</p></div>
      <div class="palette" data-stagger="0.06">{colors.map((color) => <div class="swatch" data-reveal><span class="swatch-color" style={`--swatch:${color.value}`} aria-label={color.value}></span><span class="label">{color.name}<br />{color.value}</span></div>)}</div>
      <figure class="logo-art" data-reveal="clip"><Img src="gosafe/logo.png" alt="GoSafe logo, a green directional mark beside the GoSafe wordmark" sizes="(min-width: 900px) 52vw, 80vw" /></figure>
    </section>

    <section class="principles container-wide" aria-labelledby="principles-title">
      <SectionTitle marker="#ef4444" id="principles-title">Small details, safer choices</SectionTitle>
      <div class="principle-grid" data-stagger="0.08">
        <article data-reveal><span class="label">HICK’S LAW</span><h3>Choose a way to travel</h3><p class="copy">Travel options appear as simple cards, making it easier to compare and decide.</p></article>
        <article data-reveal><span class="label">FITT’S LAW</span><h3>Are you safe?</h3><p class="copy">Large, clear “I’m Safe” and “I Need Help” actions are easy to reach.</p></article>
        <article data-reveal><span class="label">TESLER’S LAW</span><h3>Safety setup</h3><p class="copy">Students can choose a saved emergency contact during setup.</p></article>
      </div>
    </section>

    <section class="screens-section container-wide" aria-labelledby="screens-title">
      <SectionTitle marker="#3b82f6" id="screens-title">The GoSafe experience</SectionTitle>
      <p class="copy screens-lead">From choosing a route to letting someone know you made it, each screen keeps the next step clear.</p>
      <div class="screen-grid" data-stagger="0.06">{screens.map((screen) => <figure class="screen" data-reveal><div class="screen-image"><Img src={screen.src} alt={`GoSafe ${screen.title.toLowerCase()} mobile app screen`} sizes="(min-width: 900px) 24vw, 48vw" /></div><figcaption class="label">{screen.title}</figcaption></figure>)}</div>
      <figure class="screen-mosaic" data-reveal="clip"><Img src="gosafe/screen-mosaic.png" alt="Collection of GoSafe mobile app screens showing trip planning and safety features" sizes="92vw" /></figure>
    </section>

    <section class="reflection container-wide" aria-labelledby="reflection-title">
      <SectionTitle marker="#3ba776" id="reflection-title">What I learned</SectionTitle>
      <div class="reflection-copy"><p class="display">The best solution isn’t always the fastest one.</p><p class="copy">Students cared more about feeling safe than getting home quickly, so I designed for that feeling first. Testing at every stage, from paper to high fidelity, showed me how small changes like bigger buttons, clearer navigation and fewer choices matter most in stressful moments.</p></div>
    </section>

    <footer class="signature container-wide"><Img src="gosafe/logo.png" alt="GoSafe" sizes="140px" /><p class="label">KHADIJA SARDAR <span>·</span> UX DESIGN <span>·</span> FALL 2026</p></footer>
  </div>
  <NextProject current="gosafe" />
</Base>

<style>
  :global(html[data-page="gosafe"]) { color-scheme: dark; background: #0b1220; }
  :global(html[data-page="gosafe"] body) { --page-bg:#0b1220; --page-fg:#f8fafc; --body-fg:#cbd5e1; --ink-2:#cbd5e1; --ink-3:#94a3b8; --line:rgba(148,163,184,.22); --paper:#0b1220; --paper-2:#151f32; --charcoal:#0b1220; background:#0b1220; color:#f8fafc; }
  .gosafe-page { overflow:hidden; background:#0b1220; color:#f8fafc; }
  .intro { padding-top:clamp(132px,17vh,210px); }
  .crumbs { display:flex; gap:10px; color:#94a3b8; }
  .intro-copy { display:grid; grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr); align-items:end; gap:clamp(32px,8vw,130px); padding-block:clamp(42px,7vw,96px); }
  .title { font-size:var(--fs-mega); line-height:.9; letter-spacing:-.055em; font-weight:300; }
  .description { max-width:58ch; color:#cbd5e1; }
  .description strong { color:#f8fafc; }
  .hero-art { position:relative; margin-top:clamp(32px,6vw,80px); }
  .hero-art :global(img) { width:100%; border-radius:var(--radius); background:#151f32; }
  figure { margin:0; }
  figcaption { margin-top:14px; color:#94a3b8; }
  .story { display:grid; grid-template-columns:1fr 1fr; gap:clamp(36px,8vw,128px); padding-block:var(--section-gap); }
  .copy { max-width:65ch; color:#cbd5e1; font-size:var(--fs-body); line-height:1.75; }
  .research { padding-block:var(--section-gap); border-top:1px solid var(--line); }
  .research-intro { display:grid; grid-template-columns:1fr .75fr; gap:clamp(36px,9vw,140px); align-items:start; }
  .quote { margin:0; padding:0 0 0 24px; border-left:2px solid #3ba776; }
  .quote p { font-size:var(--fs-h3); line-height:1.35; color:#f8fafc; }
  .quote cite { color:#94a3b8; font-style:normal; }
  .insights,.design-cards,.principle-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:clamp(20px,4vw,56px); margin-top:clamp(48px,7vw,100px); }
  .insights article,.design-cards article,.principle-grid article { padding-top:20px; border-top:1px solid var(--line); }
  .label { color:#94a3b8; }
  h3 { margin-block:18px 10px; color:#f8fafc; font-size:var(--fs-h3); font-weight:400; letter-spacing:-.025em; }
  .persona { display:grid; grid-template-columns:.85fr 1.15fr; align-items:center; gap:clamp(36px,8vw,120px); padding-block:var(--section-gap); }
  .research-image { min-width:0; overflow:hidden; border:1px solid var(--line); border-radius:var(--radius); background:#151f32; }
  .research-image :global(img) { display:block; width:100%; height:auto; }
  .research-image figcaption { padding:0 18px 18px; }
  .maps { display:grid; grid-template-columns:1fr 1fr; gap:clamp(20px,4vw,56px); padding-bottom:var(--section-gap); }
  .insight-band { padding-block:clamp(64px,10vw,140px); background:#151f32; }
  .insight-band .display { max-width:24ch; margin-block:34px; font-size:var(--fs-h1); line-height:1.12; letter-spacing:-.045em; }
  .hmw { max-width:75ch; padding-top:26px; border-top:1px solid var(--line); }
  .design,.process,.flow,.principles,.screens-section,.reflection { padding-block:var(--section-gap); }
  .design-lead,.process-lead,.screens-lead { max-width:68ch; margin-bottom:42px; }
  .process-grid { display:grid; grid-template-columns:1fr 1fr; gap:clamp(18px,3vw,40px); }
  .process-grid .wide { grid-column:1/-1; }
  .flow .research-image { padding:18px; }
  .brand { display:grid; grid-template-columns:.8fr 1.2fr; gap:32px clamp(28px,7vw,100px); align-items:center; padding-block:var(--section-gap); background:#151f32; }
  .brand-copy { padding-left:clamp(20px,5vw,72px); }
  .palette { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; }
  .swatch { display:grid; gap:12px; }
  .swatch-color { display:block; aspect-ratio:1.5; background:var(--swatch); border-radius:8px; border:1px solid rgba(255,255,255,.12); }
  .logo-art { grid-column:1/-1; display:grid; place-items:center; min-height:150px; }
  .logo-art :global(img) { width:min(42%,300px); max-height:100px; object-fit:contain; }
  .screen-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:clamp(22px,4vw,56px) clamp(16px,3vw,36px); }
  .screen-image { display:grid; place-items:center; min-height:360px; padding:20px; border-radius:var(--radius); background:#151f32; overflow:hidden; }
  .screen-image :global(img) { width:min(100%,220px); max-height:440px; object-fit:contain; border-radius:20px; transition:transform .55s cubic-bezier(.2,.7,.2,1); }
  .screen:hover .screen-image :global(img) { transform:translateY(-7px) scale(1.035); }
  .screen figcaption { margin-top:16px; text-align:center; color:#cbd5e1; }
  .screen-mosaic { margin-top:clamp(44px,7vw,96px); overflow:hidden; border-radius:var(--radius); }
  .screen-mosaic :global(img) { display:block; width:100%; }
  .reflection { display:grid; grid-template-columns:.8fr 1.2fr; gap:clamp(36px,8vw,120px); align-items:start; border-top:1px solid var(--line); }
  .reflection-copy .display { max-width:18ch; margin-top:0; font-size:var(--fs-h1); line-height:1.12; letter-spacing:-.045em; }
  .signature { display:grid; justify-items:center; gap:22px; padding-block:clamp(60px,9vw,120px); border-top:1px solid var(--line); }
  .signature :global(img) { width:118px; height:42px; object-fit:contain; }
  .signature p { letter-spacing:.08em; }
  .signature span { color:#3ba776; padding-inline:4px; }
  @media(max-width:760px) {
    .intro-copy,.story,.research-intro,.persona,.reflection { grid-template-columns:1fr; }
    .intro-copy { gap:26px; }
    .insights,.design-cards,.principle-grid { grid-template-columns:1fr; }
    .maps,.process-grid { grid-template-columns:1fr; }
    .process-grid .wide { grid-column:auto; }
    .brand { grid-template-columns:1fr; padding-inline:20px; }
    .brand-copy { padding-left:0; }
    .palette { grid-template-columns:repeat(2,1fr); }
    .screen-grid { grid-template-columns:repeat(2,1fr); }
    .screen-image { min-height:260px; padding:12px; }
    .screen-image :global(img) { max-height:320px; }
  }
</style>
