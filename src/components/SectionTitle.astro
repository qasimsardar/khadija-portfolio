---
interface Props {
  marker: string;
  as?: 'h2' | 'h3';
  id?: string;
  /** Prisma's rotating RGB "LED" marker. */
  led?: boolean;
}

const { marker, as: Tag = 'h2', id, led = false } = Astro.props;
---

<Tag class="section-title" id={id} style={`--marker: ${marker}`}>
  <span class:list={['marker', { led }]} aria-hidden="true"></span>
  <span class="text" data-split><slot /></span>
</Tag>

<style>
  .section-title {
    display: flex;
    align-items: baseline;
    gap: clamp(14px, 1.6vw, 22px);
    margin-bottom: clamp(32px, 4.4vw, 64px);
    color: var(--page-fg);
    font-weight: 300;
    font-size: var(--fs-h2);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .text {
    display: block;
  }

  .marker {
    position: relative;
    flex: none;
    width: 0.32em;
    height: 0.32em;
    overflow: hidden;
    background: var(--marker);
    transform: translateY(-0.06em);
  }

  /* Rotating conic gradient: Prisma's RGB LED strip as a motif (transform-only animation). */
  .led {
    background: #111;
  }

  .led::before {
    content: '';
    position: absolute;
    inset: -60%;
    background: conic-gradient(#dd1886, #7d4c9e, #3e82c4, #2ee6c9, #d5ee74, #dd1886);
    animation: led-spin 4s linear infinite;
  }

  @keyframes led-spin {
    to {
      transform: rotate(1turn);
    }
  }
</style>
