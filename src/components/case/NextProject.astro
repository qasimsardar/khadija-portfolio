---
import Img from '../Img.astro';
import { nextProject } from '../../data/projects';

interface Props {
  current: string;
}

const n = nextProject(Astro.props.current);
---

<section class="next" data-accent={n.accent} style={`--next-bg: ${n.tone.bg}; --next-ink: ${n.tone.ink}`} aria-label="Next project">
  <a class="next-link" href={n.href} data-cursor="Next">
    <div class="container-wide head">
      <span class="label">Next project</span>
      <span class="title">{n.name}</span>
      <span class="pill">{n.category}</span>
    </div>
    <div class="media">
      <Img src={n.hero!.src} alt={n.hero!.alt} sizes="100vw" />
    </div>
  </a>
</section>

<style>
  .next {
    margin-top: var(--section-gap);
    background: var(--next-bg);
    color: var(--next-ink);
  }

  .next-link {
    display: block;
    overflow: hidden;
  }

  .head {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 12px 24px;
    padding-block: clamp(56px, 8vw, 120px) clamp(28px, 4vw, 56px);
  }

  .head .label {
    grid-column: 1 / -1;
  }

  .title {
    font-weight: 300;
    font-size: var(--fs-mega);
    line-height: 0.9;
    letter-spacing: -0.055em;
  }

  .media {
    overflow: hidden;
    aspect-ratio: 21 / 9;
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    transition: transform 1.4s var(--ease-out);
  }

  .next-link:hover .media :global(img),
  .next-link:focus-visible .media :global(img) {
    transform: scale(1.09);
  }

  @media (max-width: 720px) {
    .media {
      aspect-ratio: 4 / 3;
    }
  }
</style>
