---
import Img from '../Img.astro';
import type { Project } from '../../data/projects';

interface Props {
  project: Project;
  /** Dark intro band (Prisma), regardless of the page theme. */
  dark?: boolean;
  /** Optional project wordmark used in place of the text title. */
  logo?: { src: string; alt: string };
  /** Optional device mockup placed beside a custom wordmark. */
  sideMockup?: { src: string; alt: string };
}

const { project: p, dark = false, logo, sideMockup } = Astro.props;
const hero = p.hero!;
---

<section class:list={['case-hero', { dark }]} data-accent={p.accent} aria-labelledby="case-title">
  <div class="container-wide intro">
    <p class="label crumbs">
      <a class="link-draw" href="/work">Work</a>
      <span aria-hidden="true">/</span>
      <span>{p.category}</span>
    </p>
    {sideMockup ? (
      <div class="brand-intro">
        <div class="brand-copy">
          <h1 id="case-title" class:list={['brand-mark', { 'text-mark': !logo }]}>{logo ? <Img src={logo.src} alt={logo.alt} sizes="(min-width: 900px) 38vw, 80vw" eager /> : p.mark}</h1>
          <p class="lead desc" data-reveal><strong>{p.mark}</strong> {p.description}</p>
        </div>
        <div class="hero-side" data-reveal="clip"><Img src={sideMockup.src} alt={sideMockup.alt} sizes="(min-width: 900px) 56vw, 100vw" eager /></div>
      </div>
    ) : (
      <>
        <h1 id="case-title" class="display title" data-split="intro">{p.name}</h1>
        <p class="lead desc" data-reveal>
          <strong>{p.mark}</strong>
          {p.description}
        </p>
      </>
    )}
  </div>
  {!sideMockup && (
    <div class="hero-frame" data-hero>
      <div class="hero-media" transition:name={`hero-${p.slug}`} data-hero-media>
        <Img src={hero.src} alt={hero.alt} sizes="100vw" eager />
        <slot name="overlay" />
      </div>
    </div>
  )}
</section>

<style>
  .case-hero {
    padding-top: clamp(120px, 16vh, 200px);
  }

  .case-hero.dark {
    --page-fg: #f4f1ea;
    --body-fg: rgba(244, 241, 234, 0.78);
    --ink-3: rgba(244, 241, 234, 0.55);
    background: #0b0b10;
    color: var(--page-fg);
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 34rem);
    align-items: end;
    gap: 24px clamp(32px, 6vw, 120px);
    padding-bottom: clamp(36px, 5vw, 72px);
  }

  .crumbs {
    grid-column: 1 / -1;
    display: flex;
    gap: 10px;
    color: var(--ink-3);
  }

  .title {
    font-size: var(--fs-mega);
    line-height: 0.9;
    letter-spacing: -0.055em;
  }

  .desc {
    color: var(--body-fg);
  }

  .desc strong {
    color: var(--page-fg);
    font-weight: 600;
  }

  .brand-intro {
    grid-column:1 / -1;
    display:grid;
    grid-template-columns:minmax(0,.78fr) minmax(0,1.22fr);
    align-items:center;
    gap:clamp(28px,6vw,96px);
    padding-top:clamp(16px,3vw,36px);
  }

  .brand-mark { width:min(100%,480px); }
  .brand-mark :global(img) { width:100%; }
  .brand-mark.text-mark { max-width:none; font-size:var(--fs-mega); font-weight:300; line-height:.9; letter-spacing:-.055em; }
  .brand-copy .desc { max-width:48ch; margin-top:clamp(26px,4vw,48px); }
  .hero-side { overflow:hidden; border-radius:var(--radius); }
  .hero-side :global(img) { width:100%; max-height:460px; object-fit:contain; }

  .hero-frame {
    position: relative;
    overflow: hidden;
  }

  .hero-media {
    position: relative;
    will-change: transform;
  }

  .hero-media :global(img) {
    width: 100%;
  }

  @media (max-width: 900px) {
    .intro {
      grid-template-columns: 1fr;
    }
    .brand-intro { grid-template-columns:1fr; }
    .brand-mark { width:min(78%,420px); }
    .hero-side :global(img) { max-height:none; }
  }
</style>
