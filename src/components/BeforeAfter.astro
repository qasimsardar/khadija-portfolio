---
// Drag / keyboard comparison of two same-size images. A native range input drives it, so it's accessible.
import Img from './Img.astro';

interface Props {
  before: { src: string; alt: string; label: string };
  after: { src: string; alt: string; label: string };
  label: string;
}

const { before, after, label } = Astro.props;
---

<div class="ba" data-ba style="--pos: 50%">
  <div class="layer">
    <Img src={after.src} alt={after.alt} sizes="(min-width: 600px) 420px, 80vw" />
  </div>
  <div class="layer before" data-ba-before>
    <Img src={before.src} alt={before.alt} sizes="(min-width: 600px) 420px, 80vw" />
  </div>
  <div class="handle" aria-hidden="true">
    <span class="knob">
      <svg viewBox="0 0 24 24" width="18" height="18"><path d="M9 6 3 12l6 6M15 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6"></path></svg>
    </span>
  </div>
  <span class="tag tag-l label" aria-hidden="true">{before.label}</span>
  <span class="tag tag-r label" aria-hidden="true">{after.label}</span>
  <input class="range" type="range" min="0" max="100" value="50" step="1" aria-label={label} data-ba-range data-cursor="Drag" />
</div>

<script>
  function bind() {
    document.querySelectorAll<HTMLElement>('[data-ba]').forEach((root) => {
      const range = root.querySelector<HTMLInputElement>('[data-ba-range]');
      if (!range || range.dataset.bound) return;
      range.dataset.bound = '1';
      const set = () => root.style.setProperty('--pos', `${range.value}%`);
      range.addEventListener('input', set);
      set();
    });
  }
  document.addEventListener('astro:page-load', bind);
</script>

<style>
  .ba {
    --pos: 50%;
    position: relative;
    width: min(420px, 80vw);
    margin-inline: auto;
    overflow: hidden;
    border-radius: 28px;
    background: #2c2c2c;
    user-select: none;
  }

  .layer :global(img) {
    width: 100%;
  }

  .before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }

  .handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: var(--lime);
    pointer-events: none;
  }

  .knob {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--lime);
    color: #1b1b1b;
    transform: translate(-50%, -50%);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
  }

  .tag {
    position: absolute;
    top: 16px;
    padding: 6px 10px;
    border-radius: 999px;
    background: rgba(20, 20, 20, 0.7);
    color: #fff;
    pointer-events: none;
  }

  .tag-l {
    left: 16px;
  }

  .tag-r {
    right: 16px;
  }

  /* Invisible range input over the whole image: drag anywhere, arrow keys when focused. */
  .range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }

  .ba:has(.range:focus-visible) {
    outline: 2px solid var(--lime);
    outline-offset: 4px;
  }
</style>
