---
import Button from './Button.astro';
import { site } from '../data/site';

interface Props {
  workHref: string;
}

const { workHref } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container-wide hero-inner">
    <p class="label role" data-typed>{site.role}</p>
    <h1 id="hero-title" class="display headline" data-split="intro">
      Designing meaningful <span class="accent">products</span> and <span class="accent">digital experiences</span>.
    </h1>
    <div class="row">
      <p class="lead intro" data-reveal>
        I am Khadija Sardar, an industrial designer exploring the intersection of function, aesthetics and human centered
        design
      </p>
      <div class="actions" data-reveal>
        <Button href={workHref}>Explore my work</Button>
        <Button href="/#about" variant="link" magnetic={false}>More about me</Button>
      </div>
    </div>
  </div>
  <a class="scroll-cue" href={workHref} aria-label="Scroll to selected work" data-cursor="Scroll">
    <span class="label">Scroll</span>
    <span class="cue-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100svh;
    padding-block: clamp(120px, 14vh, 180px) clamp(96px, 12vh, 140px);
  }

  .hero-inner {
    display: grid;
    gap: clamp(28px, 4vw, 56px);
  }

  .role {
    color: var(--ink-3);
    min-height: 1.3em;
  }

  .headline {
    max-width: 20ch;
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 32px clamp(32px, 6vw, 120px);
    padding-top: clamp(8px, 1.5vw, 24px);
    border-top: 1px solid var(--line);
  }

  .intro {
    max-width: 34ch;
    padding-top: clamp(20px, 2vw, 32px);
    color: var(--ink-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: clamp(20px, 3vh, 36px);
    display: grid;
    justify-items: center;
    gap: 10px;
    padding: 6px 12px;
    color: var(--ink-3);
    transform: translateX(-50%);
  }

  .cue-line {
    position: relative;
    width: 1px;
    height: 44px;
    overflow: hidden;
    background: var(--line);
  }

  .cue-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--ink);
    transform: translateY(-100%);
    animation: cue 2.2s var(--ease-inout) infinite;
  }

  @keyframes cue {
    0% {
      transform: translateY(-100%);
    }
    55% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(100%);
    }
  }

  @media (max-width: 900px) {
    .row {
      grid-template-columns: 1fr;
    }

    .scroll-cue {
      display: none;
    }
  }
</style>
