---
import { site } from '../data/site';

interface Props {
  workHref: string;
}

const { workHref } = Astro.props;
---

<section class="hero container" aria-labelledby="hero-title">
  <p class="eyebrow">{site.role}</p>
  <h1 id="hero-title">Designing meaningful products and digital experiences.</h1>
  <p class="intro">
    I am Khadija Sardar, an industrial designer exploring the intersection of function, aesthetics and human
    centered design
  </p>
  <div class="actions">
    <a class="btn-solid" href={workHref}>Explore my work</a>
    <a class="btn-text" href="/#about">More about me</a>
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: 19px;
    padding-top: 10px;
    padding-bottom: 26px;
  }

  .eyebrow {
    font-weight: 300;
    font-size: var(--fs-body);
    line-height: 1.5;
    text-transform: uppercase;
  }

  h1 {
    max-width: 1080px;
    font-weight: 300;
    font-size: var(--fs-display);
    line-height: 1.2;
    letter-spacing: var(--tracking-tight);
  }

  .intro {
    font-weight: 300;
    font-size: var(--fs-body);
    line-height: 1.5;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 33px;
    margin-top: 7px;
  }

  .actions .btn-solid {
    min-width: 223px;
  }

  @media (max-width: 480px) {
    .actions .btn-solid {
      min-width: 0;
      min-height: 52px;
    }
  }
</style>
