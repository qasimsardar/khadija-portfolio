---
interface Props {
  items: string[];
}

const { items } = Astro.props;
// Repeated so one copy is always wider than the viewport; the loop shifts by exactly one copy.
const copies = [0, 1];
---

<div class="marquee" data-marquee aria-label={items.join(', ')} role="img">
  <div class="track" data-marquee-track>
    {
      copies.map((c) => (
        <p class="group" aria-hidden="true" data-marquee-group={c}>
          {items.map((t) => (
            <span class="item">
              {t}
              <span class="sep">✦</span>
            </span>
          ))}
        </p>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    padding-block: clamp(28px, 4vw, 56px);
    border-block: 1px solid var(--line);
    user-select: none;
  }

  .track {
    display: flex;
    width: max-content;
  }

  .group {
    display: flex;
    flex: none;
    font-weight: 300;
    font-size: clamp(2.5rem, 1.4rem + 4.6vw, 6.5rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  .item {
    display: inline-flex;
    align-items: center;
  }

  .item:nth-child(even) {
    font-family: var(--font-accent);
    font-style: italic;
  }

  .sep {
    display: inline-block;
    margin-inline: 0.45em;
    font-family: var(--font-sans);
    font-style: normal;
    font-size: 0.32em;
    color: var(--tiffin);
  }
</style>
