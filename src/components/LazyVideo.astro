---
// The video file loads only when it nears the viewport (handled in src/scripts/motion.ts via [data-src]).
interface Props {
  src: string;
  poster: string;
  width: number;
  height: number;
  label: string;
}

const { src, poster, width, height, label } = Astro.props;
---

<video class="lazy-video" data-src={src} poster={poster} width={width} height={height} muted loop playsinline preload="none" aria-label={label}
></video>

<style>
  .lazy-video {
    width: 100%;
    background: #0e0d10;
  }
</style>
