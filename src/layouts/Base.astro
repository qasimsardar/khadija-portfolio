---
import '@fontsource/montserrat/300.css';
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/500.css';
import '@fontsource/montserrat/600.css';
import '@fontsource/lora/400-italic.css';
import '@fontsource/source-code-pro/500.css';
import montserrat300 from '@fontsource/montserrat/files/montserrat-latin-300-normal.woff2?url';
import montserrat400 from '@fontsource/montserrat/files/montserrat-latin-400-normal.woff2?url';
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Chrome from '../components/Chrome.astro';
import { site, type Theme } from '../data/site';
import { asset } from '../lib/images';

interface Props {
  title?: string;
  description?: string;
  theme?: Theme;
  /** Project accent for the cursor, progress bar and highlights. */
  accent?: string;
  /** Case study pages get a reading-progress bar. */
  progress?: boolean;
  /** Image for social cards (path under src/assets). */
  ogImage?: string;
  /** Route key for page-specific motion (see src/scripts/motion.ts). */
  page: string;
  /** The page opens on a dark band, so the nav starts light. */
  navOnDark?: boolean;
}

const {
  title,
  description = site.description,
  theme = 'light',
  accent = '#141414',
  progress = false,
  ogImage = 'prisma/hero.jpg',
  page,
  navOnDark = false,
} = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | Industrial & UI/UX Designer`;
const themeColor = theme === 'dark' ? '#2c2c2c' : '#fefbf4';
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const og = await getImage({ src: asset(ogImage) as ImageMetadata, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 });
const ogUrl = new URL(og.src, Astro.site ?? site.url).href;
---

<!doctype html>
<html lang="en" data-page={page} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={montserrat300} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={montserrat400} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Runs before paint (and again after every client-side navigation, which replaces <html> attributes):
      // .js enables motion's initial states, .reduced-motion keeps them to fades, .skip-preloader hides the intro.
      (() => {
        const apply = () => {
          const c = document.documentElement.classList;
          c.add('js');
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) c.add('reduced-motion');
          let seen = false;
          try {
            seen = sessionStorage.getItem('ks-intro') === '1';
          } catch {}
          if (seen || c.contains('reduced-motion')) c.add('skip-preloader');
        };
        apply();
        if (!window.__ksBoot) {
          window.__ksBoot = true;
          document.addEventListener('astro:after-swap', apply);
          // Failsafe: if the motion bundle never boots, show everything.
          setTimeout(() => {
            if (!window.__ksMotion) document.documentElement.classList.remove('js');
          }, 3500);
        }
      })();
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body class:list={[`theme-${theme}`, { 'nav-on-dark': navOnDark }]} style={`--accent: ${accent}`} data-progress-page={progress ? '' : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Chrome />
    <Nav />
    <main id="main" transition:animate="none">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
